load("@kleaf//build/kernel/kleaf:kernel.bzl", "ddk_headers", "ddk_module")

package(default_visibility = [
    "//private/devices/google:__subpackages__",
    "//private/google-modules:__subpackages__",
])

# headers for cnss2 'inc'.
ddk_headers(
    name = "cnss2_headers",
    hdrs = glob([
        "inc/**/*.h",
    ]),
    includes = ["inc"],
    visibility = ["//visibility:public"],
)

# ddk_module cnss2_mhi
ddk_module(
    name = "cnss2_mhi",
    srcs = [
        "mhi/core/boot.c",
        "mhi/core/init.c",
        "mhi/core/internal.h",
        "mhi/core/main.c",
        "mhi/core/misc.h",
        "mhi/core/pm.c",
    ],
    out = "mhi.ko",
    # conditional source depend on flag in defconfig
    conditional_srcs = {
        "CONFIG_MHI_BUS_MISC": {
            True: [
                "mhi/core/misc.c",
            ],
        },
        "CONFIG_MHI_BUS_DEBUG": {
            True: [
                "mhi/core/debugfs.c",
            ],
        },
    },
    defconfig = "mhi/defconfig",
    kconfig = "mhi/Kconfig",
    kernel_build = "//private/devices/google/common:kernel",
    local_defines = [
        "DYNAMIC_DEBUG_MODULE",
    ],
    deps = [
        ":cnss2_cnss_utils",
        ":cnss2_headers",
    ],
)

# ddk_module cnss2_qmi
ddk_module(
    name = "cnss2_qmi",
    srcs = [
        "qmi/qmi_encdec.c",
        "qmi/qmi_interface.c",
    ],
    out = "qmi_helpers.ko",
    defconfig = "qmi/defconfig",
    kconfig = "qmi/Kconfig",
    kernel_build = "//private/devices/google/common:kernel",
    local_defines = [
        "DYNAMIC_DEBUG_MODULE",
    ],
    deps = [
        ":cnss2_cnss_utils",
        ":cnss2_headers",
    ],
)

# ddk_module cnss2_qrtr_qrtr
ddk_module(
    name = "cnss2_qrtr_qrtr",
    srcs = [
        "qrtr/af_qrtr.c",
        "qrtr/ns.c",
        "qrtr/qrtr.h",
    ],
    out = "qrtr.ko",
    # conditional source depend on flag in defconfig
    conditional_srcs = {
        "CONFIG_QRTR_DEBUG": {
            True: [
                "qrtr/debug.c",
                "qrtr/debug.h",
            ],
        },
    },
    defconfig = "qrtr/defconfig",
    kconfig = "qrtr/Kconfig",
    kernel_build = "//private/devices/google/common:kernel",
    local_defines = [
        "DYNAMIC_DEBUG_MODULE",
    ],
    deps = [
        ":cnss2_cnss_utils",
        ":cnss2_headers",
        ":cnss2_mhi",
    ],
)

# ddk_module cnss2_qrtr_mhi
ddk_module(
    name = "cnss2_qrtr_mhi",
    srcs = [
        "qrtr/mhi.c",
        "qrtr/qrtr.h",
    ],
    out = "qrtr-mhi.ko",
    defconfig = "qrtr/defconfig",
    kconfig = "qrtr/Kconfig",
    kernel_build = "//private/devices/google/common:kernel",
    local_defines = [
        "DYNAMIC_DEBUG_MODULE",
    ],
    deps = [
        ":cnss2_cnss_utils",
        ":cnss2_headers",
        ":cnss2_mhi",
        ":cnss2_qrtr_qrtr",
    ],
)

# ddk_module cnss2_cnss_prealloc
ddk_module(
    name = "cnss2_cnss_prealloc",
    srcs = glob([
        "cnss_utils/*.h",
    ]) + [
        "cnss_prealloc/cnss_prealloc.c",
    ],
    out = "cnss_prealloc.ko",
    kernel_build = "//private/devices/google/common:kernel",
    deps = [
        ":cnss2_cnss_utils",
        ":cnss2_headers",
    ],
)

# ddk_module cnss2_cnss_utils
ddk_module(
    name = "cnss2_cnss_utils",
    srcs = glob([
        "cnss_utils/*.h",
    ]) + [
        "cnss_utils/cnss_utils.c",
    ],
    out = "cnss_utils.ko",
    defconfig = "cnss_utils/defconfig",
    includes = ["cnss_utils"],
    kconfig = "cnss_utils/Kconfig",
    kernel_build = "//private/devices/google/common:kernel",
    local_defines = [
        "DYNAMIC_DEBUG_MODULE",
    ],
    deps = [
        ":cnss2_headers",
    ],
)

# ddk_module cnss2_cnss_plat_ipc_qmi_svc
ddk_module(
    name = "cnss2_cnss_plat_ipc_qmi_svc",
    srcs = glob([
        "cnss_utils/*.h",
    ]) + [
