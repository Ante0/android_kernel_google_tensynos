# ddk_module cnss2_cnss_nl
ddk_module(
    name = "cnss2_cnss_nl",
    srcs = [
        "cnss_genl/cnss_nl.c",
    ],
    out = "cnss_nl.ko",
    defconfig = "cnss_genl/defconfig",
    kconfig = "cnss_genl/Kconfig",
    kernel_build = "//private/devices/google/common:kernel",
    local_defines = [
        "DYNAMIC_DEBUG_MODULE",
    ],
    deps = [
        ":cnss2_cnss_utils",
        ":cnss2_headers",
    ],
