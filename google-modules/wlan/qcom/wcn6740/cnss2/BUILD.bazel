# ddk_module cnss2_cnss2
ddk_module(
    name = "cnss2_cnss2",
    srcs = glob([
        "cnss_utils/*.h",
    ]) + [
        "cnss2/bus.c",
        "cnss2/bus.h",
        "cnss2/debug.c",
        "cnss2/debug.h",
        "cnss2/genl.c",
        "cnss2/genl.h",
        "cnss2/main.c",
        "cnss2/main.h",
        "cnss2/pci.c",
        "cnss2/pci.h",
        "cnss2/pci_platform.h",
        "cnss2/pci_platform_google.c",
        "cnss2/power.c",
        "cnss2/reg.h",
    ],
    out = "cnss2.ko",
    conditional_srcs = {
        "CONFIG_CNSS2_QMI": {
            True: [
                "cnss2/qmi.c",
                "cnss2/qmi.h",
                "cnss2/coexistence_service_v01.c",
                "cnss2/coexistence_service_v01.h",
                "cnss2/ip_multimedia_subsystem_private_service_v01.c",
                "cnss2/ip_multimedia_subsystem_private_service_v01.h",
            ],
        },
        "CONFIG_QCOM_RAMDUMP": {
            True: [
                "cnss2/qcom_ramdump.c",
            ],
        },
    },
    defconfig = "cnss2/defconfig",
    kconfig = "cnss2/Kconfig",
    kernel_build = "//private/devices/google/common:kernel",
    local_defines = [
        "DYNAMIC_DEBUG_MODULE",
    ],
    deps = [
        ":cnss2_cnss_nl",
        ":cnss2_cnss_plat_ipc_qmi_svc",
        ":cnss2_cnss_prealloc",
        ":cnss2_cnss_utils",
        ":cnss2_headers",
        ":cnss2_mhi",
        ":cnss2_qmi",
        ":cnss2_qrtr_mhi",
        ":cnss2_qrtr_qrtr",
        ":cnss2_wlan_firmware_service",
        "//private/google-modules/soc/gs:headers",
        "//private/google-modules/soc/gs/drivers/pci/controller/dwc-whi:pcie-exynos-gs",
    ],
)

# ddk_module google_wlan_mac
ddk_module(
    name = "google_wlan_mac",
    srcs = [
        "wlan_mac/google_wlan_mac.c",
    ],
    out = "google_wlan_mac.ko",
    defconfig = "wlan_mac/defconfig",
    kconfig = "wlan_mac/Kconfig",
    kernel_build = "//private/devices/google/common:kernel",
    local_defines = [
        "DYNAMIC_DEBUG_MODULE",
    ],
    deps = [
        ":cnss2_cnss_utils",
        ":cnss2_headers",
    ],
)
