# ddk_module cnss2_wlan_firmware_service
ddk_module(
    name = "cnss2_wlan_firmware_service",
    srcs = glob([
        "cnss_utils/*.h",
    ]) + [
        "cnss_utils/device_management_service_v01.c",
        "cnss_utils/wlan_firmware_service_v01.c",
    ],
    out = "wlan_firmware_service.ko",
    defconfig = "cnss_utils/defconfig",
    includes = ["cnss_utils"],
    kconfig = "cnss_utils/Kconfig",
    kernel_build = "//private/devices/google/common:kernel",
    local_defines = [
