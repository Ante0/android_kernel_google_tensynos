load("@bazel_skylib//rules:common_settings.bzl", "bool_flag")
load(
    "@kleaf//build/kernel/kleaf:kernel.bzl",
    "ddk_headers",
    "ddk_module",
)

package(default_visibility = [
    "//private/devices/google:__subpackages__",
    "//private/google-modules:__subpackages__",
])

# It's here to support perf_trace_counters.ko and vh_sched.ko in soc/gs.
ddk_headers(
    name = "headers",
    hdrs = glob([
        "include/**/*.h",
    ]),
    includes = ["include"],
    visibility = [
        "//private/devices/google:__subpackages__",
        "//private/google-modules/soc/gs/drivers/soc/google:__subpackages__",
    ],
)

# Kconfig and defconfig files should not be added to the ddk_module rule because
# CONFIG_GS_PERF_MON is referenced by vh_sched.ko and perf_trace_counters.ko when
# gs_perf_mon.h is included or in their codebase. They still use the legacy
# kernel_module building method and therefore cannot access the Kconfig symbols
# exposed by ddk_module().
ddk_headers(
    name = "gs_perf_mon_api",
    hdrs = ["include/perf/core/gs_perf_mon.h"],
    includes = ["include"],
    visibility = ["//visibility:private"],
)

# The stub module when the device does not need this module.
ddk_headers(
    name = "gs_perf_mon_stub",
    # Export the API
    hdrs = [":gs_perf_mon_api"],
    visibility = ["//visibility:private"],
)

# This is to support the trace mechanism enabled by define_trace.h, where a trace header needs to
# include itself.
# `includes = ["."]` is important, because it tells bazel to look for the header in the current
# directory when others depend on this label. Without it, it defaults to look for the header in
# `include` directory.
ddk_headers(
    name = "perf_mon_trace_header_self",
    hdrs = [
        "gs_perf_mon_trace.h",
    ],
    includes = ["."],
    visibility = [
        "//visibility:private",
    ],
)

# It turns out that something like `copts = ["-I", "<a directory>"]` never works to support the
# case where a trace header needs to include itself, because bazel doesn't provide a way to get
# a directory of any kind. So we should create a separate ddk_headers to support this case.
ddk_module(
    name = "gs_perf_mon_real",
    srcs = [
        "gs_perf_mon.c",
        "gs_perf_mon_priv.h",
        "gs_perf_mon_trace.h",
    ],
    out = "gs_perf_mon.ko",
    hdrs = [":gs_perf_mon_api"],
    kernel_build = "//private/devices/google/common:kernel",
    visibility = ["//visibility:private"],
    deps = [
        ":perf_mon_trace_header_self",
        "//common:all_headers_aarch64",
    ],
)

bool_flag(
    name = "enable_gs_perf_mon",
    build_setting_default = False,
    visibility = ["//visibility:private"],
)

# Helper target to `select()` based on the flag.
config_setting(
    name = "gs_perf_mon_enabled",
    flag_values = {":enable_gs_perf_mon": "1"},
    visibility = ["//visibility:private"],
)

# The exposed target that switches between the real and stub implementation based on the flag.
alias(
    name = "gs_perf_mon",
    actual = select({
        ":gs_perf_mon_enabled": ":gs_perf_mon_real",
        "//conditions:default": ":gs_perf_mon_stub",
    }),
)

exports_files([
    "Kconfig",
])
