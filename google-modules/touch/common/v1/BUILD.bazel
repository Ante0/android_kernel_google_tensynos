load("@kleaf//build/kernel/kleaf:kernel.bzl", "checkpatch", "ddk_headers")

package(default_visibility = [
    "//private/devices/google:__subpackages__",
    "//private/google-modules:__subpackages__",
])

checkpatch(
    name = "checkpatch",
    checkpatch_pl = "//common:scripts/checkpatch.pl",
)

ddk_headers(
    name = "ddk_headers",
    hdrs = glob([
        "**/*.h",
    ]),
    includes = [
        ".",
        "include",
    ],
    visibility = [
        "//private/google-modules/touch/common:__subpackages__",
    ],
)

filegroup(
    name = "touch.common.uapi_headers",
    srcs = glob([
        "include/uapi/**/*.h",
    ]),
    visibility = [
        "//private/google-modules/touch/common:__subpackages__",
    ],
)

filegroup(
    name = "touch.common.touch_bus_negotiator",
    srcs = glob([
        "**/*.h",
    ]) + [
        "touch_bus_negotiator.c",
    ],
    visibility = [
        "//private/google-modules/touch/common:__subpackages__",
    ],
)

filegroup(
    name = "touch.common.heatmap",
    srcs = glob([
        "**/*.h",
    ]) + [
        "heatmap.c",
    ],
    visibility = [
        "//private/google-modules/touch/common:__subpackages__",
    ],
)

filegroup(
    name = "touch.common.touch_offload",
    srcs = glob([
        "**/*.h",
    ]) + [
        "touch_offload.c",
    ],
    visibility = [
        "//private/google-modules/touch/common:__subpackages__",
    ],
)

filegroup(
    name = "touch.common.goog_touch_interface",
    srcs = glob([
        "**/*.h",
    ]) + [
        "goog_touch_interface.c",
        "gti_sim.c",
        "gti_sim_sw_emulator.c",
    ],
    visibility = [
        "//private/google-modules/touch/common:__subpackages__",
    ],
)
