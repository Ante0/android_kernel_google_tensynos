load("@kleaf//build/kernel/kleaf:kernel.bzl", "ddk_module")
load("//private/google-modules/display/vsi-drm/bridge/synopsys/dsi2host:dw-mipi-dsi2h-cflags.bzl", "DW_MIPI_DSI2H_COPTS")

package(default_visibility = [
    "//private/devices/google:__subpackages__",
    "//private/google-modules:__subpackages__",
])

ddk_module(
    name = "mipi-dsi2h",
    srcs = glob([
        "**/*.h",
    ]) + [
        "dw-mipi-dsi2h.c",
        "dw-mipi-dsi2h-debugfs.c",
        "dw-mipi-dsi2h-regmap-limits.c",
        "dw-mipi-dsi2h-sscd.c",
        "dw-mipi-dsi2h-sysfs.c",
    ],
    out = "mipi-dsi2h.ko",
    copts = DW_MIPI_DSI2H_COPTS,
    kernel_build = "//private/devices/google/common:kernel",
    local_defines = [
        "DYNAMIC_DEBUG_MODULE=1",
    ],
    deps = [
        "//common:all_headers_aarch64",
        "//private/google-modules/display/common/gs_drm:gs-drm-connector",
        "//private/google-modules/display/vsi-drm:ddk_headers",
        "//private/google-modules/display/vsi-drm/phy/synopsys:mipi-cdphy",
        "//private/google-modules/soc/rdo:rdo_soc_headers",
    ],
)

exports_files(
    [
        "Kconfig",
    ],
    [
        "//private/google-modules/display/vsi-drm:__pkg__",
    ],
)
