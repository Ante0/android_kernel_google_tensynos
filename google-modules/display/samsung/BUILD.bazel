# SPDX-License-Identifier: GPL-2.0

# the drm device driver.  This driver provides support for the
# Direct Rendering Infrastructure (DRI) in XFree86 4.1.0 and higher.

load("@kleaf//build/kernel/kleaf:kernel.bzl", "checkpatch", "ddk_headers", "ddk_module", "ddk_uapi_headers")

package(default_visibility = [
    "//private/devices/google:__subpackages__",
    "//private/google-modules:__subpackages__",
])

checkpatch(
    name = "checkpatch",
    checkpatch_pl = "//common:scripts/checkpatch.pl",
)

filegroup(
    name = "display.samsung.kconfig",
    srcs = [
        "Kconfig",
        "//private/google-modules/display/samsung/panel:display.samsung.panel.kconfig",
    ],
    visibility = [
        "//private/devices/google:__subpackages__",
    ],
)

ddk_uapi_headers(
    name = "uapi_headers",
    srcs = glob([
        "include/uapi/**/*.h",
    ]) + [
        "//common:include/uapi/drm/drm_fourcc.h",
    ],
    out = "display-samsung-uapi-headers.tar.gz",
    kernel_build = "//private/devices/google/common:kernel",
    visibility = [
        "//private/devices/google:__subpackages__",
    ],
)

ddk_headers(
    name = "headers",
    hdrs = glob([
        "include/**/*.h",
    ]) + [
        "exynos_drm_connector.h",
        "exynos_drm_format.h",
        "//private/google-modules/display/common:ddk_headers",
        "//private/google-modules/display/samsung/panel:headers",
    ],
    includes = [
        ".",
        "include/uapi",
    ],
    visibility = [
        "//private/devices/google:__subpackages__",
        "//private/google-modules/aoc/alsa:__subpackages__",
        "//private/google-modules/touch:__subpackages__",
    ],
)

ddk_headers(
    name = "internal_headers",
    hdrs = glob([
        "**/*.h",
    ]) + [
        "//private/google-modules/display/common:ddk_headers",
        "//private/google-modules/display/samsung/panel:headers",
    ],
    includes = [
        ".",
        "cal_common",
        "cal_stub",
        "include/uapi",
    ],
    visibility = [
        ":__subpackages__",
    ],
)

ddk_module(
    name = "exynos-drm",
    srcs = glob([
        "**/*.h",
    ]) + [
        "exynos_drm_connector.c",
        "exynos_drm_crtc.c",
        "exynos_drm_debug.c",
        "exynos_drm_dqe.c",
        "exynos_drm_drv.c",
        "exynos_drm_fb.c",
        "exynos_drm_format.c",
        "exynos_drm_gem.c",
        "exynos_drm_hibernation.c",
        "exynos_drm_partial.c",
        "exynos_drm_plane.c",
        "exynos_drm_recovery.c",
    ],
    out = "exynos-drm.ko",
    conditional_srcs = {
        "CONFIG_DRM_SAMSUNG_DECON": {
            True: [
                "exynos_drm_decon.c",
            ],
        },
        "CONFIG_DRM_SAMSUNG_DP": {
            True: [
                "exynos_drm_dp.c",
            ],
        },
        "CONFIG_DRM_SAMSUNG_DP_ZUMA": {
            True: [
                "displayport/dp_zuma.c",
            ],
        },
        "CONFIG_DRM_SAMSUNG_DPP": {
            True: [
                "exynos_drm_dpp.c",
            ],
        },
        "CONFIG_DRM_SAMSUNG_DSI": {
            True: [
                "exynos_drm_dsim.c",
            ],
        },
        "CONFIG_DRM_SAMSUNG_TUI": {
            True: [
                "exynos_drm_tui.c",
            ],
        },
        "CONFIG_DRM_SAMSUNG_WB": {
            True: [
                "exynos_drm_writeback.c",
            ],
        },
        "CONFIG_EXYNOS_BTS": {
            True: [
                "exynos_drm_bts.c",
            ],
        },
        "CONFIG_DRM_SAMSUNG_CAL_9845": {
            True: [
                "cal_9845/decon_reg.c",
                "cal_9845/dpp_reg.c",
                "cal_9845/dqe_reg.c",
                "cal_9845/dsim_reg.c",
                "cal_9845/hdr_reg.c",
            ],
        },
        "CONFIG_DRM_SAMSUNG_CAL_9855": {
            True: [
                "cal_9855/decon_reg.c",
                "cal_9855/dpp_reg.c",
                "cal_9855/dqe_reg.c",
            ],
        },
        "CONFIG_DRM_SAMSUNG_CAL_9865": {
            True: [
                "cal_9865/decon_reg.c",
                "cal_9865/dpp_reg.c",
                "cal_9865/dqe_reg.c",
                "cal_9865/dsim_reg.c",
                "cal_9865/hdr_reg.c",
            ],
        },
        "CONFIG_DRM_SAMSUNG_CAL_9865_DP": {
            True: [
                "cal_9865/dp_reg.c",
            ],
        },
    },
    copts = [
        "-Werror",
    ],
    kernel_build = "//private/devices/google/common:kernel",
    local_defines = [
        "DYNAMIC_DEBUG_MODULE=1",
    ],
    deps = [
        ":internal_headers",
        "//common:all_headers_aarch64",
        "//private/google-modules/bms/misc:logbuffer",
        "//private/google-modules/display/common/gs_drm:gs-drm-connector",
        "//private/google-modules/display/common/gs_panel:gs-panel",
        "//private/google-modules/soc/gs:headers",
        "//private/google-modules/soc/gs/drivers/bts",
        "//private/google-modules/soc/gs/drivers/soc/google:exynos-cpupm",
        "//private/google-modules/soc/gs/drivers/soc/google:exynos-pd_el3",
        "//private/google-modules/soc/gs/drivers/soc/google:exynos_pm_qos",
        "//private/google-modules/soc/gs/drivers/soc/google/cal-if:cmupmucal",
        "//private/google-modules/soc/gs/drivers/soc/google/debug:dss",
        "//private/google-modules/soc/gs/drivers/soc/google/debug:itmon",
        "//private/google-modules/soc/gs/drivers/tty/serial:exynos_tty",
        "//private/google-modules/soc/gs/drivers/usb/dwc3:dwc3-exynos-usb",
    ] + select({
        "//private/devices/google/common:soc_is_gs201_or_before": [
            "//private/google-modules/soc/gs/drivers/devfreq-whi/google:exynos_devfreq",
        ],
        "//conditions:default": [
            "//private/google-modules/hdcp/samsung:exynos-hdcp2",
            "//private/google-modules/soc/gs/drivers/devfreq/google:exynos_devfreq",
        ],
    }),
)

ddk_module(
    name = "exynos-drm-audio",
    srcs = [
        "dp_audio/dp_dma.c",
        "dp_audio/dp_dma.h",
    ],
    out = "exynos-drm-audio.ko",
    hdrs = [
        "dp_audio/dp_audio.h",
    ],
    copts = [
        "-Werror",
    ],
    includes = [
        "dp_audio",
    ],
    kernel_build = "//private/devices/google/common:kernel",
    local_defines = [
        "DYNAMIC_DEBUG_MODULE=1",
    ],
    deps = [
        ":exynos-drm",
        ":internal_headers",
        "//common:all_headers_aarch64",
        "//private/google-modules/aoc/alsa:headers",
        "//private/google-modules/soc/gs:headers",
        "//private/google-modules/soc/gs/drivers/dma:samsung-dma",
        "//private/google-modules/soc/gs/drivers/soc/google:exynos-cpupm",
    ],
)
