ddk_module(
    name = "google_max77759_bcl_irq_test",
    srcs = [
        "test/max77759_bcl_irq_tests.c",
    ],
    out = "google_max77759_bcl_irq_test.ko",
    defconfig = "test/kunit_defconfig",
    kconfig = "test/Kconfig",
    kernel_build = "//private/devices/google/common:kernel",
    deps = [
