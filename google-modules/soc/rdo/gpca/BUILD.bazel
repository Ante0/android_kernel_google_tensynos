load("//build/kernel/kleaf:kernel.bzl", "ddk_module")

package(default_visibility = [
    "//private/devices/google:__subpackages__",
    "//private/google-modules:__subpackages__",
])

filegroup(
    name = "kconfig",
    srcs = [
        "Kconfig",
    ],
    visibility = [
        "//private/devices/google:__subpackages__",
    ],
)

ddk_module(
    name = "gpca",
    srcs = glob([
        "**/*.h",
    ]),
    out = "gpca.ko",
    conditional_srcs = {
        "CONFIG_GOOGLE_GPCA": {
            True: [
                "gpca_asymm.c",
                "gpca_cipher.c",
                "gpca_cmd.c",
                "gpca_crypto.c",
                "gpca_ecdsa_sig.asn1.c",
                "gpca_hash.c",
                "gpca_key_policy.c",
                "gpca_keys.c",
                "gpca_op_queue.c",
                "gpca_platform.c",
            ],
        },
    },
    kernel_build = "//private/devices/google/common:kernel",
    deps = [
        "//common:all_headers_aarch64",
        "//private/google-modules/soc/gs:headers",
        "//private/google-modules/soc/rdo:rdo_soc_headers",
    ],
)
