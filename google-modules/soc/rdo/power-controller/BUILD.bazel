load("//build/kernel/kleaf:kernel.bzl", "ddk_module")

package(default_visibility = [
    "//private/devices/google:__subpackages__",
    "//private/google-modules:__subpackages__",
])

filegroup(
    name = "kconfig",
    srcs = [
        "Kconfig",
    ],
    visibility = [
        "//private/devices/google:__subpackages__",
    ],
)

ddk_module(
    name = "power_controller",
    srcs = glob([
        "**/*.h",
    ]),
    out = "power_controller.ko",
    conditional_srcs = {
        "CONFIG_GOOGLE_POWER_CONTROLLER": {
            True: [
                "gpu_core_logic.c",
                "latency/pd_latency_profile.c",
                "latency/pd_latency_stats.c",
                "lga_cpm_mappings.c",
                "mbu_cpm_mappings.c",
                "power_controller_main.c",
            ],
        },
    },
    kernel_build = "//private/devices/google/common:kernel",
    local_defines = [
        "DYNAMIC_DEBUG_MODULE",
    ],
    deps = [
        "//common:all_headers_aarch64",
        "//private/google-modules/perf/infra/mbfs",
        "//private/google-modules/perf/infra/mbfs:headers",
        "//private/google-modules/soc/gs:headers",
        "//private/google-modules/soc/rdo:rdo_soc_headers",
        "//private/google-modules/soc/rdo/drivers/soc/google:goog-mba-cpm-iface",
    ],
)
