load("@kleaf//build/kernel/kleaf:kernel.bzl", "ddk_module")

package(default_visibility = [
    "//private/devices/google:__subpackages__",
    "//private/google-modules:__subpackages__",
])

filegroup(
    name = "fwtp.kconfig",
    srcs = ["Kconfig"],
    visibility = ["//private/devices/google:__subpackages__"],
)

ddk_module(
    name = "fwtp_lib",
    srcs = [
        "fwtp.c",
        "fwtp_decode.c",
        "fwtp_ipc_client.c",
        "fwtp_printer.c",
    ],
    out = "fwtp_lib.ko",
    hdrs = [
        "fwtp.h",
        "fwtp_decode.h",
        "fwtp_entry.h",
        "fwtp_err.h",
        "fwtp_ftrace.h",
        "fwtp_if.h",
        "fwtp_ipc_client.h",
        "fwtp_platform.h",
        "fwtp_printer.h",
        "fwtp_protocol.h",
        "fwtp_ring.h",
    ],
    includes = ["."],
    kernel_build = "//private/devices/google/common:kernel",
    local_defines = ["DYNAMIC_DEBUG_MODULE"],
    deps = [
        "//common:all_headers_aarch64",
        "//private/google-modules/soc/rdo:rdo_soc_headers",
        "//private/google-modules/soc/rdo/drivers/soc/google:google_gtc",
        "//private/google-modules/soc/rdo/drivers/soc/google:google_timestamp_sync",
    ],
)

ddk_module(
    name = "fwtp_cpm",
    srcs = [
        "cpm_decoder/cpm_trace.h",
        "cpm_decoder/cpm_tracepoint_decoder.c",
        "cpm_decoder/cpm_tracepoint_decoder.h",
        "cpm_decoder/perf_tracepoints.c",
        "cpm_decoder/perf_tracepoints.h",
        "cpm_decoder/power_tracepoints.c",
        "cpm_decoder/power_tracepoints.h",
        "cpm_decoder/thermal_tracepoints.c",
        "cpm_decoder/thermal_tracepoints.h",
        "fwtp_cpm.c",
    ],
    out = "fwtp_cpm_module.ko",
    kernel_build = "//private/devices/google/common:kernel",
    local_defines = ["DYNAMIC_DEBUG_MODULE"],
    deps = [
        ":fwtp_lib",
        "//common:all_headers_aarch64",
        "//private/google-modules/perf/thermal:google_thermal_cpm_mbox",
        "//private/google-modules/soc/rdo:rdo_soc_headers",
        "//private/google-modules/soc/rdo/drivers/soc/google:goog-mba-cpm-iface",
        "//private/google-modules/soc/rdo/drivers/soc/google:google_timestamp_sync",
        "//private/google-modules/soc/rdo/drivers/soc/google/dvfs-helper:dvfs_helper",
    ],
)

ddk_module(
    name = "fwtp_google_gdmc",
    srcs = ["fwtp_google_gdmc.c"],
    out = "fwtp_google_gdmc.ko",
    kernel_build = "//private/devices/google/common:kernel",
    local_defines = ["DYNAMIC_DEBUG_MODULE"],
    deps = [
        ":fwtp_lib",
        "//common:all_headers_aarch64",
        "//private/google-modules/soc/rdo:rdo_soc_headers",
        "//private/google-modules/soc/rdo/drivers/soc/google:goog-mba-gdmc-iface",
    ],
)
