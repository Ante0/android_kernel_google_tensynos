load("@kleaf//build/kernel/kleaf:kernel.bzl", "ddk_module")

package(default_visibility = [
    "//private/devices/google:__subpackages__",
    "//private/google-modules:__subpackages__",
])

filegroup(
    name = "kconfig",
    srcs = [
        "Kconfig",
    ],
    visibility = [
        "//private/devices/google:__subpackages__",
    ],
)

ddk_module(
    name = "gcdd",
    out = "gcdd.ko",
    conditional_srcs = {
        "CONFIG_GOOGLE_CRASH_DEBUG_DUMP": {
            True: [
                "google-cdd.c",
                "google-cdd-dpm.c",
                "google-cdd-local.h",
                "google-cdd-log.c",
                "google-cdd-log-suspend.c",
                "google-cdd-utils.c",
            ],
        },
    },
    kernel_build = "//private/devices/google/common:kernel",
    deps = [
        "//common:all_headers_aarch64",
        "//private/google-modules/soc/rdo:rdo_soc_headers",
        "//private/google-modules/soc/rdo/watchdog:google_wdt",
    ],
)
