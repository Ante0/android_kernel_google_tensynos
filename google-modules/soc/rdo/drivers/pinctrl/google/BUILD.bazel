load("@kleaf//build/kernel/kleaf:kernel.bzl", "ddk_module")

package(default_visibility = [
    "//private/devices/google:__subpackages__",
    "//private/google-modules:__subpackages__",
])

filegroup(
    name = "kconfig",
    srcs = [
        "Kconfig",
    ],
    visibility = [
        "//private/devices/google:__subpackages__",
    ],
)

ddk_module(
    name = "pinctrl",
    srcs = glob([
        "**/*.h",
    ]),
    out = "pinctrl.ko",
    conditional_srcs = {
        "CONFIG_DEBUG_FS": {
            True: [
                "pinctrl-debugfs.c",
            ],
        },
        "CONFIG_PINCTRL_GOOGLE": {
            True: [
                "common.c",
                "pinctrl-trace.c",
            ],
        },
        "CONFIG_PINCTRL_LGA": {
            True: [
                "pinctrl-lga.c",
            ],
        },
        "CONFIG_PINCTRL_MBU": {
            True: [
                "pinctrl-mbu.c",
            ],
        },
        "CONFIG_PINCTRL_RDO": {
            True: [
                "pinctrl-rdo.c",
            ],
        },
    },
    kernel_build = "//private/devices/google/common:kernel",
    deps = [
        "//common:all_headers_aarch64",
        "//private/google-modules/soc/rdo:rdo_soc_headers",
    ],
)
