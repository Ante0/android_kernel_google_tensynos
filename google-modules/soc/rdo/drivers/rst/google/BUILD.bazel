load("@kleaf//build/kernel/kleaf:kernel.bzl", "ddk_module")

package(default_visibility = [
    "//private/devices/google:__subpackages__",
    "//private/google-modules:__subpackages__",
])

filegroup(
    name = "kconfig",
    srcs = [
        "Kconfig",
    ],
    visibility = [
        "//private/devices/google:__subpackages__",
    ],
)

ddk_module(
    name = "rst-cpm",
    srcs = glob([
        "**/*.h",
    ]),
    out = "rst-cpm.ko",
    conditional_srcs = {
        "CONFIG_GOOGLE_CPM_RST": {
            True: [
                "rst-cpm.c",
            ],
        },
    },
    kernel_build = "//private/devices/google/common:kernel",
    deps = [
        "//common:all_headers_aarch64",
        "//private/google-modules/soc/rdo:rdo_soc_headers",
        "//private/google-modules/soc/rdo/drivers/soc/google:goog-mba-cpm-iface",
    ],
)

ddk_module(
    name = "rst-cpm_test_module",  # Added "_module" for the error _kernel_module rule 'rst-cpm_test' conflicts with existing hermetic_test rule
    srcs = glob([
        "**/*.h",
    ]),
    out = "rst-cpm_test.ko",
    conditional_srcs = {
        "CONFIG_GOOGLE_CPM_RST_TEST": {
            True: [
                "rst-cpm_test.c",
            ],
        },
    },
    kernel_build = "//private/devices/google/common:kernel",
    deps = [
        "//common:all_headers_aarch64",
        "//private/google-modules/soc/rdo:rdo_soc_headers",
    ],
)
