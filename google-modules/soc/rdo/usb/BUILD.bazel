load("//build/kernel/kleaf:kernel.bzl", "ddk_headers", "ddk_module")

package(default_visibility = [
    "//private/devices/google:__subpackages__",
    "//private/google-modules:__subpackages__",
])

filegroup(
    name = "kconfig",
    srcs = [
        "Kconfig",
    ],
    visibility = [
        "//private/devices/google:__subpackages__",
    ],
)

ddk_headers(
    name = "usb_trace_headers",
    hdrs = [
        "usb_trace.h",
    ],
    includes = [
        ".",
    ],
)

ddk_module(
    name = "dwc3-google",
    srcs = glob([
        "**/*.h",
    ]),
    out = "dwc3-google.ko",
    conditional_srcs = {
        "CONFIG_USB_DWC3_GOOGLE": {
            True: [
                "dwc3-google.c",
            ],
        },
    },
    kernel_build = "//private/devices/google/common:kernel",
    deps = [
        ":usb_trace_headers",
        "//common:all_headers_aarch64",
        "//private/google-modules/soc/gs:headers",
        "//private/google-modules/soc/rdo:rdo_soc_headers",
        "//private/google-modules/soc/rdo/interconnect:google_icc",
        "//private/google-modules/soc/rdo/phy:google-usb-phy",
    ],
)

ddk_module(
    name = "dwc3-google-aux",
    srcs = glob([
        "**/*.h",
    ]),
    out = "dwc3-google-aux.ko",
    conditional_srcs = {
        "CONFIG_USB_DWC3_GOOGLE_AUX": {
            True: [
                "dwc3-google-aux.c",
            ],
        },
    },
    kernel_build = "//private/devices/google/common:kernel",
    deps = [
        ":usb_trace_headers",
        "//common:all_headers_aarch64",
        "//private/google-modules/soc/gs:headers",
        "//private/google-modules/soc/rdo:rdo_soc_headers",
        "//private/google-modules/soc/rdo/interconnect:google_icc",
    ],
)
