config ZRAM_GS
	tristate "Compressed RAM block device support"
	depends on BLOCK && SYSFS && MMU
	select ZSMALLOC
	help
	  Creates virtual block devices called /dev/zramX (X = 0, 1, ...).
	  Pages written to these disks are compressed and stored in memory
	  itself. These disks allow very fast I/O and compression provides
	  good amounts of memory savings.

	  It has several use cases, for example: /tmp storage, use as swap
	  disks and maybe many more.

	  See Documentation/admin-guide/blockdev/zram.rst for more information.

config ZCOMP_CPU
	tristate "CPU compression"
	depends on ZRAM_GS
	default n
	help
	  Support CPU compressor. User should configuire it via echo
	  "lzo" > /sys/block/zramX/comp_algorithm

config ZCOMP_EH
	tristate "Support Emerald Hill HW compressor"
	depends on ZRAM_GS
	select GOOGLE_EH
	default n
	help
	  Support Emerald Hill HW compressor. User should configure it via
	  echo "lz77eh" > /sys/block/zramX/comp_algorithm

config ZRAM_GS_BACKEND_LZO
	bool "lzo and lzo-rle compression support"
	depends on ZRAM_GS
	select LZO_COMPRESS
	select LZO_DECOMPRESS

config ZRAM_GS_BACKEND_LZ4
	bool "lz4 compression support"
	depends on ZRAM_GS
	select LZ4_COMPRESS
	select LZ4_DECOMPRESS

config ZRAM_GS_BACKEND_LZ4HC
	bool "lz4hc compression support"
	depends on ZRAM_GS
	select LZ4HC_COMPRESS
	select LZ4_DECOMPRESS

config ZRAM_GS_BACKEND_ZSTD
	bool "zstd compression support"
	depends on ZRAM_GS
	select ZSTD_COMPRESS
	select ZSTD_DECOMPRESS

config ZRAM_GS_BACKEND_DEFLATE
	bool "deflate compression support"
	depends on ZRAM_GS
	select ZLIB_DEFLATE
	select ZLIB_INFLATE

config ZRAM_GS_BACKEND_842
	bool "842 compression support"
	depends on ZRAM_GS
	select 842_COMPRESS
	select 842_DECOMPRESS

choice
	prompt "Default zram compressor"
	default ZRAM_GS_DEF_COMP_LZORLE
	depends on ZRAM_GS

config ZRAM_GS_DEF_COMP_LZORLE
	bool "lzo-rle"
	depends on ZRAM_GS_BACKEND_LZO

config ZRAM_GS_DEF_COMP_LZO
	bool "lzo"
	depends on ZRAM_GS_BACKEND_LZO

config ZRAM_GS_DEF_COMP_LZ4
	bool "lz4"
	depends on ZRAM_GS_BACKEND_LZ4

config ZRAM_GS_DEF_COMP_LZ4HC
	bool "lz4hc"
	depends on ZRAM_GS_BACKEND_LZ4HC

config ZRAM_GS_DEF_COMP_ZSTD
	bool "zstd"
	depends on ZRAM_GS_BACKEND_ZSTD

config ZRAM_GS_DEF_COMP_DEFLATE
	bool "deflate"
	depends on ZRAM_GS_BACKEND_DEFLATE

config ZRAM_GS_DEF_COMP_842
	bool "842"
	depends on ZRAM_GS_BACKEND_842

endchoice

config ZRAM_GS_DEF_COMP
	string
	depends on ZRAM_GS
	default "lzo-rle" if ZRAM_GS_DEF_COMP_LZORLE
	default "lzo" if ZRAM_GS_DEF_COMP_LZO
	default "lz4" if ZRAM_GS_DEF_COMP_LZ4
	default "lz4hc" if ZRAM_GS_DEF_COMP_LZ4HC
	default "zstd" if ZRAM_GS_DEF_COMP_ZSTD
	default "deflate" if ZRAM_GS_DEF_COMP_DEFLATE
	default "842" if ZRAM_GS_DEF_COMP_842
	default "unset-value"

config ZRAM_GS_WRITEBACK
       bool "Write back incompressible or idle page to backing device"
       depends on ZRAM_GS
       help
	 This lets zram entries (incompressible or idle pages) be written
	 back to a backing device, helping save memory.
	 For this feature, admin should set up backing device via
	 /sys/block/zramX/backing_dev.

	 With /sys/block/zramX/{idle,writeback}, application could ask
	 idle page's writeback to the backing device to save in memory.

	 See Documentation/admin-guide/blockdev/zram.rst for more information.

config ZRAM_GS_TRACK_ENTRY_ACTIME
	bool "Track access time of zram entries"
	depends on ZRAM_GS
	help
	  With this feature zram tracks access time of every stored
	  entry (page), which can be used for a more fine grained IDLE
	  pages writeback.

config ZRAM_GS_MEMORY_TRACKING
	bool "Track zRam block status"
	depends on ZRAM_GS && DEBUG_FS
	select ZRAM_GS_TRACK_ENTRY_ACTIME
	help
	  With this feature, admin can track the state of allocated blocks
	  of zRAM. Admin could see the information via
	  /sys/kernel/debug/zram/zramX/block_state.

	  See Documentation/admin-guide/blockdev/zram.rst for more information.

config ZRAM_GS_MULTI_COMP
	bool "Enable multiple compression streams"
	depends on ZRAM_GS
	help
	  This will enable multi-compression streams, so that ZRAM can
	  re-compress pages using a potentially slower but more effective
	  compression algorithm. Note, that IDLE page recompression
	  requires ZRAM_TRACK_ENTRY_ACTIME.

config ZRAM_GS_SLOWPATH_COMP
	bool "Enable slow path compression stream"
	depends on ZRAM_GS_MULTI_COMP
	help
	  This will enable a secondary compression algorithm for ZRAM's slow path.
	  This allows ZRAM to use a different compression algorithm, which may be
	  slower but can achieve a higher compression ratio. This more effective
	  compression is used when system is not under memory pressure, potentially
	  saving more memory.

config ZRAM_GS_ANDROID_IOCTL
       bool "zram ioctl interface for Android"
       depends on ZRAM_GS_WRITEBACK
       help
	 With this feature, admin can use the zram ioctl interface to operate
	 on a target process's virtual memory areas (VMAs) in zram. Then we can
	 invokes the corresponding operations like writeback the compressed
	 pages into the backing device.

config ZRAM_GS_VENDOR_HOOK
	bool "Enable zram vendor hooks"
	depends on ZRAM_GS
	default n
	help
	  Enable the zram vendor hooks. It provides a set of hooks for vendor
	  to implement their own logic.
	  For example, vendor could implement their block device read/write
	  page functions to improve performance.
