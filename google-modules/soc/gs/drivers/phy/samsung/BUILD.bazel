load("//build/kernel/kleaf:kernel.bzl", "ddk_module")

package(default_visibility = [
    "//private/devices/google:__subpackages__",
    "//private/google-modules:__subpackages__",
])

filegroup(
    name = "kconfig",
    srcs = [
        "Kconfig",
    ],
    visibility = [
        "//private/devices/google:__subpackages__",
    ],
)

ddk_module(
    name = "phy-exynos-usbdrd-eusb-super",
    srcs = glob([
        "**/*.h",
    ]),
    out = "phy-exynos-usbdrd-eusb-super.ko",
    conditional_srcs = {
        "CONFIG_PHY_EXYNOS_USBDRD_EUSB": {
            True: [
                "exynos-usb-blkcon.c",
                "phy-exynos-eusb.c",
                "phy-exynos-snps-usbdp.c",
                "phy-exynos-usbdrd-eusb.c",
            ],
        },
    },
    kernel_build = "//private/devices/google/common:kernel",
    deps = [
        ":eusb_repeater",
        "//common:all_headers_aarch64",
        "//private/google-modules/soc/gs:headers",
        "//private/google-modules/soc/gs/drivers/soc/google:exynos-pd_el3",
        "//private/google-modules/soc/gs/drivers/soc/google:exynos-pd_hsi0",
    ],
)

ddk_module(
    name = "eusb_repeater",
    srcs = glob([
        "**/*.h",
    ]),
    out = "eusb_repeater.ko",
    conditional_srcs = {
        "CONFIG_PHY_EXYNOS_EUSB_REPEATER": {
            True: [
                "eusb_repeater.c",
            ],
        },
    },
    kernel_build = "//private/devices/google/common:kernel",
    deps = [
        "//common:all_headers_aarch64",
        "//private/google-modules/soc/gs:headers",
        "//private/google-modules/soc/gs/drivers/i2c/busses:headers",
    ],
)

ddk_module(
    name = "phy-exynos-usbdrd-super",
    srcs = glob([
        "**/*.h",
    ]),
    out = "phy-exynos-usbdrd-super.ko",
    conditional_srcs = {
        "CONFIG_PHY_EXYNOS_USBDRD": {
            True: [
                "phy-exynos-usb3p1.c",
                "phy-exynos-usbdp-gen2-v4.c",
                "phy-exynos-usbdrd.c",
            ],
        },
    },
    kernel_build = "//private/devices/google/common:kernel",
    deps = [
        "//common:all_headers_aarch64",
        "//private/google-modules/soc/gs:headers",
        "//private/google-modules/soc/gs/drivers/soc/google:exynos-pd_el3",
        "//private/google-modules/soc/gs/drivers/soc/google:exynos-pd_hsi0",
    ],
)

ddk_module(
    name = "phy-exynos-mipi-dsim",
    srcs = glob([
        "**/*.h",
    ]),
    out = "phy-exynos-mipi-dsim.ko",
    conditional_srcs = {
        "CONFIG_PHY_EXYNOS_MIPI_DSIM": {
            True: [
                "phy-exynos-mipi-dsim.c",
            ],
        },
    },
    kernel_build = "//private/devices/google/common:kernel",
    deps = [
        "//common:all_headers_aarch64",
        "//private/google-modules/soc/gs:headers",
        "//private/google-modules/soc/gs/drivers/soc/google:exynos-pmu-if",
    ],
)

ddk_module(
    name = "phy-exynos-mipi",
    srcs = glob([
        "**/*.h",
    ]),
    out = "phy-exynos-mipi.ko",
    conditional_srcs = {
        "CONFIG_PHY_EXYNOS_MIPI": {
            True: [
                "phy-exynos-mipi.c",
            ],
        },
    },
    kernel_build = "//private/devices/google/common:kernel",
    deps = [
        "//common:all_headers_aarch64",
        "//private/google-modules/soc/gs:headers",
        "//private/google-modules/soc/gs/drivers/soc/google:exynos-pmu-if",
    ],
)

filegroup(
    name = "kconfig_group",
    srcs = [
        "//private/google-modules/soc/gs/drivers/phy/samsung:kconfig",
    ],
    visibility = [
        "//private/devices/google:__subpackages__",
    ],
)
