# Exynos GS pin control drivers

load("//build/kernel/kleaf:kernel.bzl", "ddk_module")

package(default_visibility = [
    "//private/devices/google:__subpackages__",
    "//private/google-modules:__subpackages__",
])

filegroup(
    name = "kconfig",
    srcs = [
        "Kconfig",
    ],
    visibility = [
        "//private/devices/google:__subpackages__",
    ],
)

ddk_module(
    name = "pinctrl-exynos-gs",
    srcs = glob([
        "**/*.h",
    ]),
    out = "pinctrl-exynos-gs.ko",
    conditional_srcs = {
        "CONFIG_PINCTRL_EXYNOS_GS": {
            True: [
                "pinctrl-exynos-arm64.c",
                "pinctrl-exynos.c",
                "pinctrl-gs.c",
                "pinctrl-gs201.c",
                "pinctrl-samsung.c",
            ],
        },
    },
    copts = [
        "-include",
        "pinctrl_defines.h",
    ],
    kernel_build = "//private/devices/google/common:kernel",
    deps = [
        "//common:all_headers_aarch64",
        "//private/google-modules/soc/gs:headers",
        "//private/google-modules/soc/gs/drivers/pinctrl:pinctrl-defines-header",
        "//private/google-modules/soc/gs/drivers/soc/google:exynos-pmu-if",
    ],
)
