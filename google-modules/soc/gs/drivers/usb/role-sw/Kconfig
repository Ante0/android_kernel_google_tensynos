config GOOGLE_USB_ROLE_SW
	tristate "USB data role switch for Google devices"
	depends on EXTCON
	select GOOGLE_VOTABLE
	help
	  'GOOGLE_USB_ROLE_SW' is a virtual device for collecting any
	  Google specific USB data role switch limitations. The virtual
	  device will aggregate usb data role switch requests from
	  different drivers and elect a valid one, then pass it to down-
	  stream device. Say 'Y' or 'M' if you need this device.

config GOOGLE_USB_ROLE_SW_KUNIT_TEST
	tristate "Google USB role switch driver tests" if !KUNIT_ALL_TESTS
	depends on KUNIT
	default KUNIT_ALL_TESTS
	help
	  This will build the test suite that will verify the functionalities of
	  the Google USB Role Switch driver.

	  This config is only meant to be used in development of the driver, not
	  for distribution.