load("//build/kernel/kleaf:kernel.bzl", "ddk_module")

package(default_visibility = [
    "//private/devices/google:__subpackages__",
    "//private/google-modules:__subpackages__",
])

filegroup(
    name = "kconfig",
    srcs = [
        "Kconfig",
    ],
    visibility = [
        "//private/devices/google:__subpackages__",
    ],
)

ddk_module(
    name = "dwc3-exynos-usb",
    srcs = glob([
        "**/*.h",
    ]),
    out = "dwc3-exynos-usb.ko",
    conditional_srcs = {
        "CONFIG_USB_DWC3_EXYNOS_GS": {
            True: [
                "dwc3-exynos-otg.c",
                "dwc3-exynos.c",
            ],
        },
    },
    kernel_build = "//private/devices/google/common:kernel",
    deps = [
        "//common:all_headers_aarch64",
        "//private/google-modules/bms/misc:gvotable",
        "//private/google-modules/soc/gs:headers",
        "//private/google-modules/soc/gs/drivers/soc/google:exynos-cpupm",
        "//private/google-modules/soc/gs/drivers/soc/google:exynos-pd_hsi0",
        "//private/google-modules/soc/gs/drivers/soc/google:exynos_pm_qos",
    ] + select({
        "//private/devices/google/common:soc_is_zuma_or_zumapro": [
            "//private/google-modules/soc/gs/drivers/phy/samsung:phy-exynos-usbdrd-eusb-super",
        ],
        "//private/devices/google/common:soc_is_gs201_or_before": [
            "//private/google-modules/soc/gs/drivers/phy/samsung:phy-exynos-usbdrd-super",
        ],
        "//conditions:default": [
        ],
    }),
)
