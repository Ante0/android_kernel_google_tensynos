# Google memory latency drivers

load("//build/kernel/kleaf:kernel.bzl", "ddk_module")

package(default_visibility = [
    "//private/devices/google:__subpackages__",
    "//private/google-modules:__subpackages__",
])

filegroup(
    name = "kconfig",
    srcs = [
        "Kconfig",
    ],
    visibility = [
        "//private/devices/google:__subpackages__",
    ],
)

ddk_module(
    name = "gs_governor_memlat",
    srcs = glob([
        "**/*.h",
    ]),
    out = "gs_governor_memlat.ko",
    conditional_srcs = {
        "CONFIG_GS_MEMLAT_GOVERNOR": {
            True: [
                "gs_governor_memlat.c",
            ],
        },
    },
    kernel_build = "//private/devices/google/common:kernel",
    local_defines = [
        "DYNAMIC_DEBUG_MODULE",
    ],
    deps = [
        ":gs_governor_utils",
        "//common:all_headers_aarch64",
        "//private/google-modules/soc/gs:headers",
        "//private/google-modules/soc/gs/drivers/performance/gs_perf_mon",
        "//private/google-modules/soc/gs/drivers/soc/google:exynos_pm_qos",
    ],
)

ddk_module(
    name = "gs_governor_utils",
    srcs = glob([
        "**/*.h",
    ]),
    out = "gs_governor_utils.ko",
    conditional_srcs = {
        "CONFIG_GS_MEMLAT_GOVERNOR": {
            True: [
                "gs_governor_utils.c",
            ],
        },
    },
    kernel_build = "//private/devices/google/common:kernel",
    local_defines = [
        "DYNAMIC_DEBUG_MODULE",
    ],
    deps = [
        "//common:all_headers_aarch64",
        "//private/google-modules/soc/gs:headers",
    ],
)

ddk_module(
    name = "gs_governor_dsulat",
    srcs = glob([
        "**/*.h",
    ]),
    out = "gs_governor_dsulat.ko",
    conditional_srcs = {
        "CONFIG_GS_DSULAT_GOVERNOR": {
            True: [
                "gs_governor_dsulat.c",
            ],
        },
    },
    kernel_build = "//private/devices/google/common:kernel",
    local_defines = [
        "DYNAMIC_DEBUG_MODULE",
    ],
    deps = [
        ":gs_governor_utils",
        "//common:all_headers_aarch64",
        "//private/google-modules/soc/gs:headers",
        "//private/google-modules/soc/gs/drivers/performance/gs_perf_mon",
        "//private/google-modules/soc/gs/drivers/soc/google:exynos_pm_qos",
    ],
)
