load("//build/kernel/kleaf:kernel.bzl", "ddk_module")

package(default_visibility = [
    "//private/devices/google:__subpackages__",
    "//private/google-modules:__subpackages__",
])

filegroup(
    name = "kconfig",
    srcs = [
        "Kconfig",
    ],
    visibility = [
        "//private/devices/google:__subpackages__",
    ],
)

ddk_module(
    name = "s2mpg13_spmic_thermal",
    out = "s2mpg13_spmic_thermal.ko",
    conditional_srcs = {
        "CONFIG_GSOC_PMIC_THERMAL": {
            True: [
                "s2mpg13_spmic_thermal.c",
            ],
        },
    },
    kernel_build = "//private/devices/google/common:kernel",
    deps = [
        "//common:all_headers_aarch64",
        "//private/google-modules/soc/gs:headers",
        "//private/google-modules/soc/gs/drivers/mfd:s2mpg13-mfd",
        "//private/google-modules/soc/gs/drivers/soc/google/vh/kernel/metrics:pixel_metrics",
    ],
)

ddk_module(
    name = "gs101_spmic_thermal",
    out = "gs101_spmic_thermal.ko",
    conditional_srcs = {
        "CONFIG_GSOC_PMIC_THERMAL": {
            True: [
                "gs101_spmic_thermal.c",
            ],
        },
    },
    kernel_build = "//private/devices/google/common:kernel",
    deps = [
        "//common:all_headers_aarch64",
        "//private/google-modules/soc/gs:headers",
