        "//common:all_headers_aarch64",
        "//private/google-modules/soc/gs:headers",
        "//private/google-modules/soc/gs/drivers/mfd:s2mpg15-mfd",
        "//private/google-modules/soc/gs/drivers/soc/google/vh/kernel/metrics:pixel_metrics",
    ],
)

ddk_module(
    name = "sts4x_ambient_i2c",
    out = "sts4x_ambient_i2c.ko",
    conditional_srcs = {
        "CONFIG_THERMAL_SENSOR_STS4X": {
            True: [
