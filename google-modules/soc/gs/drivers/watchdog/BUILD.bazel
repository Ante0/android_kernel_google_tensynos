# ARM Architecture

load("//build/kernel/kleaf:kernel.bzl", "ddk_module")

package(default_visibility = [
    "//private/devices/google:__subpackages__",
    "//private/google-modules:__subpackages__",
])

filegroup(
    name = "kconfig",
    srcs = [
        "Kconfig",
    ],
    visibility = [
        "//private/devices/google:__subpackages__",
    ],
)

ddk_module(
    name = "s3c2410_wdt",
    out = "s3c2410_wdt.ko",
    conditional_srcs = {
        "CONFIG_S3C2410_WATCHDOG_GS": {
            True: [
                "s3c2410_wdt.c",
            ],
        },
    },
    kernel_build = "//private/devices/google/common:kernel",
    deps = [
        "//common:all_headers_aarch64",
        "//private/google-modules/soc/gs:headers",
        "//private/google-modules/soc/gs/drivers/soc/google:exynos-pd_el3",
        "//private/google-modules/soc/gs/drivers/soc/google:exynos-pmu-if",
        "//private/google-modules/soc/gs/drivers/soc/google/debug:dss",
    ] + select({
        "//private/devices/google/common:soc_is_zumapro": [
        ],
        "//conditions:default": [
            "//private/google-modules/soc/gs/drivers/soc/google/debug:etm2dram",
        ],
    }),
)
