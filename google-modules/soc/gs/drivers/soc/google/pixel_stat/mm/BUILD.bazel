load("//build/kernel/kleaf:kernel.bzl", "ddk_module")

package(default_visibility = [
    "//private/devices/google:__subpackages__",
    "//private/google-modules:__subpackages__",
])

ddk_module(
    name = "pixel_stat_mm",
    srcs = glob([
        "**/*.h",
    ]),
    out = "pixel_stat_mm.ko",
    conditional_srcs = {
        "CONFIG_PIXEL_STAT_MM": {
            True: [
                "cma.c",
                "compaction.c",
                "filemap.c",
                "init.c",
                "meminfo.c",
                "page_alloc.c",
                "procfs_node.c",
                "sysfs_node.c",
                "vmscan.c",
            ],
        },
    },
    kernel_build = "//private/devices/google/common:kernel",
    deps = [
        "//common:all_headers_aarch64",
        "//private/google-modules/soc/gs:headers",
        "//private/google-modules/soc/gs/drivers/dma-buf/heaps/samsung:headers",
        "//private/google-modules/soc/gs/drivers/soc/google/pixel_stat:pixel_stat_sysfs",
        "//private/google-modules/soc/gs/drivers/soc/google/vh:headers",
        "//private/google-modules/soc/gs/drivers/soc/google/vh/kernel/sched:vh_sched",
        "//private/google-modules/trusty:trusty_headers",
    ],
)
