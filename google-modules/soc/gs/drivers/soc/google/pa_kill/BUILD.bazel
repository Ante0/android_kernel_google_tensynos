# Procative Kill

load("//build/kernel/kleaf:kernel.bzl", "ddk_headers", "ddk_module")

package(default_visibility = [
    "//private/devices/google:__subpackages__",
    "//private/google-modules:__subpackages__",
])

filegroup(
    name = "kconfig",
    srcs = [
        "Kconfig",
    ],
    visibility = [
        "//private/devices/google:__subpackages__",
    ],
)

ddk_headers(
    name = "trace_headers",
    hdrs = [
        "pa_kill_core.h",
        "pa_kill_sysfs.h",
    ],
    includes = ["."],
)

ddk_module(
    name = "pa_kill",
    srcs = glob([
        "**/*.h",
    ]),
    out = "pa_kill.ko",
    conditional_srcs = {
        "CONFIG_PROACTIVE_KILL": {
            True: [
                "pa_kill_core.c",
                "pa_kill_sysfs.c",
            ],
        },
    },
    kernel_build = "//private/devices/google/common:kernel",
    deps = [
        ":trace_headers",
        "//common:all_headers_aarch64",
        "//private/google-modules/soc/gs:headers",
        "//private/google-modules/soc/gs/drivers/soc/google/vh:headers",
        "//private/google-modules/soc/gs/drivers/soc/google/vh/kernel:systrace",
        "//private/google-modules/soc/gs/drivers/soc/google/vh/kernel/mm:vh_mm",
    ],
)
