# GCMA

load("//build/kernel/kleaf:kernel.bzl", "ddk_headers", "ddk_module")

package(default_visibility = [
    "//private/devices/google:__subpackages__",
    "//private/google-modules:__subpackages__",
])

filegroup(
    name = "kconfig",
    srcs = [
        "Kconfig",
    ],
    visibility = [
        "//private/devices/google:__subpackages__",
    ],
)

ddk_headers(
    name = "gcma_trace_headers",
    hdrs = [
        "gcma_trace.h",
    ],
    includes = ["."],
)

ddk_module(
    name = "gcma",
    srcs = glob([
        "**/*.h",
    ]),
    out = "gcma.ko",
    conditional_srcs = {
        "CONFIG_ANDROID_VENDOR_HOOKS": {
            True: [
                "gcma_vh.c",
            ],
        },
        "CONFIG_DEBUG_FS": {
            True: [
                "gcma_debug.c",
            ],
        },
        "CONFIG_PIXEL_GCMA": {
            True: [
                "gcma_core.c",
                "gcma_sysfs.c",
            ],
        },
    },
    kernel_build = "//private/devices/google/common:kernel",
    deps = [
        ":gcma_trace_headers",
        "//common:all_headers_aarch64",
        "//private/google-modules/soc/gs:headers",
        "//private/google-modules/soc/gs/drivers/soc/google/vh/kernel/mm:vh_mm",
    ],
)
