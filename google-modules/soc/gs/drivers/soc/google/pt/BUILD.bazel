# the PT API

load("//build/kernel/kleaf:kernel.bzl", "ddk_headers", "ddk_module")

package(default_visibility = [
    "//private/devices/google:__subpackages__",
    "//private/google-modules:__subpackages__",
])

filegroup(
    name = "kconfig",
    srcs = [
        "Kconfig",
    ],
    visibility = [
        "//private/devices/google:__subpackages__",
    ],
)

ddk_headers(
    name = "pt_trace_headers",
    hdrs = [
        "pt_trace.h",
    ],
    includes = ["."],
)

ddk_module(
    name = "slc_pt",
    srcs = glob([
        "**/*.h",
    ]),
    out = "slc_pt.ko",
    conditional_srcs = {
        "CONFIG_SLC_PARTITION_MANAGER": {
            True: [
                "pt_trace_points.c",
            ],
        },
        "CONFIG_SLC_PARTITION_MANAGER_LEGACY": {
            True: [
                "pt-legacy.c",
            ],
            False: [
                "pt.c",
            ],
        },
    },
    kernel_build = "//private/devices/google/common:kernel",
    deps = [
        ":pt_trace_headers",
        "//common:all_headers_aarch64",
        "//private/google-modules/soc/gs:headers",
    ],
)

ddk_module(
    name = "slc_dummy",
    srcs = glob([
        "**/*.h",
    ]),
    out = "slc_dummy.ko",
    conditional_srcs = {
        "CONFIG_SLC_PARTITION_MANAGER": {
            True: [
                "slc_dummy.c",
            ],
        },
    },
    kernel_build = "//private/devices/google/common:kernel",
    deps = [
        ":slc_pt",
        "//common:all_headers_aarch64",
        "//private/google-modules/soc/gs:headers",
    ],
)

ddk_module(
    name = "slc_acpm",
    srcs = glob([
        "**/*.h",
    ]),
    out = "slc_acpm.ko",
    conditional_srcs = {
        "CONFIG_GS_SLC_ACPM": {
            True: [
                "slc_acpm.c",
            ],
        },
    },
    kernel_build = "//private/devices/google/common:kernel",
    deps = [
        ":slc_pmon",
        ":slc_pt",
        "//common:all_headers_aarch64",
        "//private/google-modules/soc/gs:headers",
        "//private/google-modules/soc/gs/drivers/soc/google/acpm:gs_acpm",
        "//private/google-modules/soc/gs/drivers/soc/google/cal-if:headers",
    ],
)

ddk_module(
    name = "slc_pmon",
    srcs = glob([
        "**/*.h",
    ]),
    out = "slc_pmon.ko",
    conditional_srcs = {
        "CONFIG_GS_SLC_ACPM": {
            True: [
                "slc_pmon.c",
            ],
        },
    },
    kernel_build = "//private/devices/google/common:kernel",
    deps = [
        "//common:all_headers_aarch64",
        "//private/google-modules/soc/gs:headers",
        "//private/google-modules/soc/gs/drivers/soc/google/acpm:gs_acpm",
    ],
)
