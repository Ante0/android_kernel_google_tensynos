load("@kleaf//build/kernel/kleaf:kernel.bzl", "ddk_module")

package(default_visibility = [
    "//private/devices/google:__subpackages__",
    "//private/google-modules:__subpackages__",
])

filegroup(
    name = "gsa.kconfig",
    srcs = [
        "Kconfig",
    ],
    visibility = [
        "//private/devices/google:__subpackages__",
    ],
)

ddk_module(
    name = "gsa_ko",
    srcs = glob([
        "**/*.h",
    ]),
    out = "gsa.ko",
    conditional_srcs = {
        "CONFIG_GSA": {
            True: [
                "gsa_core.c",
                "gsa_log.c",
                "gsa_tz.c",
            ],
        },
        "CONFIG_GSA_DEBUGFS": {
            True: [
                "gsa_debugfs.c",
            ],
        },
        "CONFIG_GSA_LEGACY_MAILBOX": {
            True: [
                "gsa_mbox_legacy.c",
            ],
        },
        "CONFIG_GSA_LINUX_MAILBOX": {
            True: [
                "gsa_mbox.c",
            ],
        },
    },
    copts = [
        "-Wno-missing-prototypes",
    ],
    kernel_build = "//private/devices/google/common:kernel",
    deps = [
        "//common:all_headers_aarch64",
        "//private/google-modules/soc/gs:headers",
        "//private/google-modules/trusty:trusty-ipc",
        "//private/google-modules/trusty:trusty_headers",
    ],
)

ddk_module(
    name = "gsa_gsc",
    srcs = glob([
        "**/*.h",
    ]),
    out = "gsa_gsc.ko",
    conditional_srcs = {
        "CONFIG_GSA_GSC": {
            True: [
                "gsa_gsc.c",
            ],
        },
    },
    copts = [
        "-Wno-missing-prototypes",
    ],
    kernel_build = "//private/devices/google/common:kernel",
    deps = [
        ":gsa_ko",
        "//common:all_headers_aarch64",
        "//private/google-modules/soc/gs:headers",
        "//private/google-modules/trusty:trusty_headers",
    ],
)

ddk_module(
    name = "gsa_ipc",
    srcs = glob([
        "**/*.h",
    ]),
    out = "gsa_ipc.ko",
    conditional_srcs = {
        "CONFIG_GSA_IPC": {
            True: [
                "gsa_ipc.c",
            ],
        },
    },
    copts = [
        "-Wno-missing-prototypes",
    ],
    kernel_build = "//private/devices/google/common:kernel",
    deps = [
        ":gsa_ko",
        "//common:all_headers_aarch64",
        "//private/google-modules/soc/gs:headers",
        "//private/google-modules/trusty:trusty_headers",
    ],
)

ddk_module(
    name = "tzprot",
    srcs = glob([
        "**/*.h",
    ]),
    out = "tzprot.ko",
    conditional_srcs = {
        "CONFIG_TZ_PROT": {
            True: [
                "tzprot.c",
            ],
        },
    },
    copts = [
        "-Wno-missing-prototypes",
    ],
    kernel_build = "//private/devices/google/common:kernel",
    deps = [
        ":gsa_ko",
        "//common:all_headers_aarch64",
        "//private/google-modules/soc/gs:headers",
        "//private/google-modules/trusty:trusty_headers",
    ],
)

ddk_module(
    name = "gsa_core_kunit_test",
    srcs = [
        "gsa_core_test.c",
        "gsa_integration_test.c",
        "gsa_log.h",
        "gsa_mbox.h",
        "gsa_priv.h",
        "gsa_tz.h",
        "mock_gsa_mbox.c",
        "mock_gsa_mbox.h",
    ],
    out = "gsa_kunit_test.ko",
    copts = [
        "-Wno-missing-prototypes",
    ],
    kernel_build = "//private/devices/google/common:kernel",
    deps = [
        ":gsa_gsc",
        ":gsa_ko",
        ":tzprot",
        "//common:all_headers_aarch64",
        "//private/google-modules/soc/gs:headers",
        "//private/google-modules/trusty:trusty_headers",
    ],
)

# Public headers are located at
# //private/google-modules/soc/gs:headers
