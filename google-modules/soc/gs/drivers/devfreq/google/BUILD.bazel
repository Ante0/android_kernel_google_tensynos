# Exynos DEVFREQ Drivers

load("//build/kernel/kleaf:kernel.bzl", "ddk_headers", "ddk_module")

package(default_visibility = [
    "//private/devices/google:__subpackages__",
    "//private/google-modules:__subpackages__",
])

filegroup(
    name = "kconfig",
    srcs = [
        "Kconfig",
    ],
    visibility = [
        "//private/devices/google:__subpackages__",
    ],
)

ddk_headers(
    name = "governor_memlat_header",
    hdrs = [
        "governor_memlat.h",
    ],
    includes = ["."],
)

ddk_headers(
    name = "gs-ppc_header",
    hdrs = [
        "gs-ppc.h",
    ],
    includes = ["."],
)

ddk_module(
    name = "exynos_devfreq",
    srcs = glob([
        "**/*.h",
    ]),
    out = "exynos_devfreq.ko",
    conditional_srcs = {
        "CONFIG_ARM_EXYNOS_DEVFREQ": {
            True: [
                "governor_simpleinteractive.c",
                "gs-devfreq.c",
            ],
        },
        "CONFIG_EXYNOS_ALT_DVFS": {
            True: [
                "gs-ppc.c",
            ],
        },
    },
    kernel_build = "//private/devices/google/common:kernel",
    local_defines = [
        "DYNAMIC_DEBUG_MODULE",
    ],
    deps = [
        ":gs-ppc_header",
        "//common:all_headers_aarch64",
        "//private/google-modules/soc/gs:headers",
        "//private/google-modules/soc/gs/drivers/soc/google:ect_parser",
        "//private/google-modules/soc/gs/drivers/soc/google:exynos-dm",
        "//private/google-modules/soc/gs/drivers/soc/google:exynos-pd",
        "//private/google-modules/soc/gs/drivers/soc/google:exynos_pm_qos",
        "//private/google-modules/soc/gs/drivers/soc/google/acpm:gs_acpm",
        "//private/google-modules/soc/gs/drivers/soc/google/acpm:headers",
        "//private/google-modules/soc/gs/drivers/soc/google/cal-if:cmupmucal",
        "//private/google-modules/soc/gs/drivers/soc/google/cal-if:headers",
        "//private/google-modules/soc/gs/drivers/soc/google/debug:dss",
        "//private/google-modules/soc/gs/drivers/soc/google/vh/kernel:systrace",
    ],
)

ddk_module(
    name = "arm-memlat-mon",
    srcs = glob([
        "**/*.h",
    ]),
    out = "arm-memlat-mon.ko",
    conditional_srcs = {
        "CONFIG_ARM_MEMLAT_MON": {
            True: [
                "arm-memlat-mon.c",
            ],
        },
    },
    kernel_build = "//private/devices/google/common:kernel",
    local_defines = [
        "DYNAMIC_DEBUG_MODULE",
    ],
    deps = [
        "//common:all_headers_aarch64",
        "//private/google-modules/soc/gs:headers",
    ],
)

ddk_headers(
    name = "governor_memlat_trace_header",
    hdrs = [
        "governor_memlat_trace.h",
    ],
    includes = ["."],
)

ddk_module(
    name = "governor_memlat",
    srcs = glob([
        "**/*.h",
    ]),
    out = "governor_memlat.ko",
    conditional_srcs = {
        "CONFIG_DEVFREQ_GOV_MEMLAT": {
            True: [
                "governor_memlat.c",
            ],
        },
    },
    kernel_build = "//private/devices/google/common:kernel",
    local_defines = [
        "DYNAMIC_DEBUG_MODULE",
    ],
    deps = [
        ":governor_memlat_trace_header",
        "//common:all_headers_aarch64",
        "//private/google-modules/soc/gs:headers",
    ],
)

ddk_headers(
    name = "governor_dsulat_trace_header",
    hdrs = [
        "governor_dsulat_trace.h",
    ],
    includes = ["."],
)

ddk_module(
    name = "governor_dsulat",
    srcs = glob([
        "**/*.h",
    ]),
    out = "governor_dsulat.ko",
    conditional_srcs = {
        "CONFIG_DEVFREQ_GOV_MEMLAT": {
            True: [
                "governor_dsulat.c",
            ],
        },
    },
    kernel_build = "//private/devices/google/common:kernel",
    local_defines = [
        "DYNAMIC_DEBUG_MODULE",
    ],
    deps = [
        ":governor_dsulat_trace_header",
        "//common:all_headers_aarch64",
        "//private/google-modules/soc/gs:headers",
    ],
)

ddk_module(
    name = "memlat-devfreq",
    srcs = glob([
        "**/*.h",
    ]),
    out = "memlat-devfreq.ko",
    conditional_srcs = {
        "CONFIG_MEMLAT_DEVFREQ": {
            True: [
                "memlat-devfreq.c",
            ],
        },
    },
    kernel_build = "//private/devices/google/common:kernel",
    local_defines = [
        "DYNAMIC_DEBUG_MODULE",
    ],
    deps = [
        "//common:all_headers_aarch64",
        "//private/google-modules/soc/gs:headers",
    ],
)

ddk_module(
    name = "dsulat-devfreq",
    srcs = glob([
        "**/*.h",
    ]),
    out = "dsulat-devfreq.ko",
    conditional_srcs = {
        "CONFIG_MEMLAT_DEVFREQ": {
            True: [
                "dsulat-devfreq.c",
            ],
        },
    },
    kernel_build = "//private/devices/google/common:kernel",
    local_defines = [
        "DYNAMIC_DEBUG_MODULE",
    ],
    deps = [
        "//common:all_headers_aarch64",
        "//private/google-modules/soc/gs:headers",
    ],
)
