load("//build/kernel/kleaf:kernel.bzl", "ddk_headers", "ddk_module")

package(default_visibility = [
    "//private/devices/google:__subpackages__",
    "//private/google-modules:__subpackages__",
])

filegroup(
    name = "kconfig",
    srcs = [
        "Kconfig",
    ],
    visibility = [
        "//private/devices/google:__subpackages__",
    ],
)

ddk_headers(
    name = "exynos-pcie-iommu-exp_headers",
    hdrs = [
        "exynos-pcie-iommu-exp.h",
    ],
    includes = ["."],
)

ddk_module(
    name = "samsung_iommu",
    srcs = glob([
        "**/*.h",
    ]),
    out = "samsung_iommu.ko",
    conditional_srcs = {
        "CONFIG_SAMSUNG_IOMMU": {
            True: [
                "samsung-iommu-fault.c",
                "samsung-iommu.c",
            ],
        },
    },
    kernel_build = "//private/devices/google/common:kernel",
    deps = [
        "//common:all_headers_aarch64",
        "//private/google-modules/soc/gs:headers",
        "//private/google-modules/soc/gs/drivers/soc/google/debug:dss",
        "//private/google-modules/soc/gs/drivers/soc/google/pkvm-s2mpu",
    ],
)

ddk_module(
    name = "samsung-iommu-group",
    srcs = glob([
        "**/*.h",
    ]),
    out = "samsung-iommu-group.ko",
    conditional_srcs = {
        "CONFIG_SAMSUNG_IOMMU_GROUP": {
            True: [
                "samsung-iommu-group.c",
            ],
        },
    },
    kernel_build = "//private/devices/google/common:kernel",
    deps = [
        "//common:all_headers_aarch64",
        "//private/google-modules/soc/gs:headers",
    ],
)

ddk_module(
    name = "samsung-secure-iova",
    srcs = glob([
        "**/*.h",
    ]),
    out = "samsung-secure-iova.ko",
    conditional_srcs = {
        "CONFIG_SAMSUNG_SECURE_IOVA": {
            True: [
                "samsung-secure-iova.c",
            ],
        },
    },
    kernel_build = "//private/devices/google/common:kernel",
    deps = [
        "//common:all_headers_aarch64",
        "//private/google-modules/soc/gs:headers",
    ],
)

ddk_module(
    name = "iovad-vendor-hooks",
    srcs = glob([
        "**/*.h",
    ]),
    out = "iovad-vendor-hooks.ko",
    conditional_srcs = {
        "CONFIG_IOVAD_VENDOR_HOOKS": {
            True: [
                "iovad-vendor-hooks.c",
            ],
        },
    },
    kernel_build = "//private/devices/google/common:kernel",
    deps = [
        "//common:all_headers_aarch64",
        "//private/google-modules/soc/gs:headers",
    ],
)

ddk_module(
    name = "dma-iommu-vendor-hooks",
    srcs = [
        "dma-iommu-vendor-hooks.c",
    ],
    out = "dma-iommu-vendor-hooks.ko",
    kernel_build = "//private/devices/google/common:kernel",
    deps = [
        "//common:all_headers_aarch64",
        "//private/google-modules/soc/gs:headers",
    ],
)

ddk_module(
    name = "samsung_iommu_v9",
    srcs = glob([
        "**/*.h",
    ]),
    out = "samsung_iommu_v9.ko",
    conditional_srcs = {
        "CONFIG_SAMSUNG_IOMMU_V9": {
            True: [
                "samsung-iommu-fault-v9.c",
                "samsung-iommu-v9.c",
            ],
        },
    },
    kernel_build = "//private/devices/google/common:kernel",
    deps = [
        "//common:all_headers_aarch64",
        "//private/google-modules/soc/gs:headers",
        "//private/google-modules/soc/gs/drivers/soc/google/debug:dss",
        "//private/google-modules/soc/gs/drivers/soc/google/pkvm-s2mpu:pkvm-s2mpu-v9",
    ],
)

ddk_module(
    name = "exynos-pcie-iommu",
    srcs = glob([
        "**/*.h",
    ]),
    out = "exynos-pcie-iommu.ko",
    conditional_srcs = {
        "CONFIG_SOC_ZUMA": {
            True: [
                "exynos-pcie-iommu-zuma.c",
            ],
            False: [
                "exynos-pcie-iommu-whi.c",
            ],
        },
    },
    kernel_build = "//private/devices/google/common:kernel",
    deps = [
        "//common:all_headers_aarch64",
        "//private/google-modules/soc/gs:headers",
    ],
)

ddk_module(
    name = "iommu_map_benchmark",
    srcs = glob([
        "**/*.h",
    ]),
    out = "iommu_map_benchmark.ko",
    conditional_srcs = {
        "CONFIG_PIXEL_IOMMU_MAP_BENCHMARK": {
            True: [
                "iommu_map_benchmark.c",
            ],
        },
    },
    kernel_build = "//private/devices/google/common:kernel",
    deps = [
        "//common:all_headers_aarch64",
        "//private/google-modules/soc/gs:headers",
    ],
)
