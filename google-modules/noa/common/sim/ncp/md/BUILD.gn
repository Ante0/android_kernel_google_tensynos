  public_configs = [ ":modules_iph_include_path" ]
  public = [ "$dir_noa_ncp_modules_iph/sys_common.h" ]
  public_deps = [
    "$dir_noa_apps/noa/common:headers",
    "$dir_noa_common:core",
    "$dir_noa_common:ring",
    "$dir_noa_modules/buffer_mgmt:buffer_mgmt",
    "$dir_noa_modules/device_mgmt:device_mgmt",
    "$dir_noa_modules/linux_port:bitops",
    "$dir_noa_modules/linux_port:container_of",
    "$dir_noa_modules/linux_port:device",
    "$dir_noa_modules/linux_port:dma-mapping",
    "$dir_noa_modules/linux_port:jiffies",
    "$dir_noa_modules/linux_port:list",
    "$dir_noa_modules/linux_port:mutex",
    "$dir_noa_modules/linux_port:spinlock",
    "$dir_noa_modules/linux_port:timer",
    "$dir_noa_modules/linux_port:tasklet",
    "$dir_noa_modules/linux_port:workqueue",
    "$dir_noa_services/ring_service",
    "$dir_noa_ncp_modem:sys_log_iph",
  ]
}

pw_source_set("ncp_modem_data_iph") {
  public_configs = [ ":modules_iph_include_path" ]
  public = [ "$dir_noa_ncp_modules_iph/ncp_modem_data.h" ]
  public_deps = [
      "$dir_noa_drivers/modem:modem_hif_alcedo",
      "$dir_noa_drivers/modem:noa_common_alcedo_headers",
      "$dir_noa_ncp_modem:sys_common_iph",
  ]
}

pw_source_set("apc2ncp_ring_iph") {
  public_configs = [
    ":modules_iph_include_path",
    ":modem_iph_include_path",
  ]
  public = [
    "$dir_noa_ncp_modules_iph/ncp_md_irq.h",
    "$dir_noa_ncp_modules_iph/noa_md_apc2ncp_ring.h",
  ]
  deps = [
    "$dir_noa_apps/noa/common:headers",
    "$dir_noa_drivers/hwio",
    "$dir_noa_modules/notifier:notifier_mailbox",
    "$dir_noa_ncp_modem:sys_log_iph",
    "$dir_noa_services/ring_service:ring_manager",
  ]
  sources = [
    "modules_iph/ncp_md_irq.cc",
    "modules_iph/noa_md_apc2ncp_ring.cc",
  ]
}

pw_source_set("noa_ncp_modem_iph") {
  public_configs = [
    ":modules_iph_include_path",
    ":modem_iph_include_path",
  ]
  if (noa_modem_dynamic_switch_disabled) {
    public_configs += [ ":modem_dynamic_switch" ]
  }
  public = [
    "modules_iph/modem_fw_mailbox.h",
    "modules_iph/modem_fw_ring.h",
    "modules_iph/modem_interface.h",
    "modules_iph/ncp_md_irq.h",
    "modules_iph/noa_md_apc2ncp_ring.h",
    "mediatek/iph/ncp_md.h",
    "mediatek/iph/ncp_md_rx_data.h",
    "mediatek/iph/ncp_md_shmem_sync.h",
    "mediatek/iph/ncp_md_tx_data.h",
  ]
  deps = [
    "$dir_noa_common:core",
    "$dir_noa_common:ring",
    "$dir_noa_drivers/hwio",
    "$dir_noa_drivers/modem:modem_hif_alcedo",
    "$dir_noa_modules/noa_configs",
    "$dir_noa_modules/notifier:notifier_mailbox",
    "$dir_noa_ncp_modem:sys_common_iph",
    "$dir_noa_ncp_modem:ncp_modem_data_iph",
    "$dir_noa_ncp_modem:sys_log_iph",
    "$dir_noa_services/ring_event_rpc_service:client",
    "$dir_noa_services/ring_service",
    "$dir_pw_function",
  ]
  public_deps = [
    "$dir_noa_drivers/modem:noa_common_alcedo_headers",
  ]
  sources = [
    "modules_iph/modem_fw_mailbox.cc",
    "modules_iph/modem_fw_ring.cc",
    "modules_iph/modem_interface.cc",
    "modules_iph/ncp_md_irq.cc",
    "modules_iph/noa_md_apc2ncp_ring.cc",
    "mediatek/iph/ncp_md.cc",
    "mediatek/iph/ncp_md_rx_data.cc",
    "mediatek/iph/ncp_md_shmem_sync.cc",
    "mediatek/iph/ncp_md_tx_data.cc",
  ]
}
