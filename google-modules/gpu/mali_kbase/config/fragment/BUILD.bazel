package(default_visibility = [
    "//private/devices/google:__subpackages__",
    "//private/google-modules:__subpackages__",
])

exports_files(glob([
    "*.fragment",
]))

filegroup(
    name = "baseconfig",
    srcs =
        [
            ":base.fragment",
        ],
)

genrule(
    name = "base_defconfig",
    srcs = [":baseconfig"],
    outs = ["common/base.defconfig"],
    cmd = "cat $(SRCS) >> $(OUTS)",
)

filegroup(
    name = "coresightconfig",
    srcs =
        select({
            "//private/google-modules/gpu/mali_kbase/config:mali_coresight": [":coresight.fragment"],
            "//conditions:default": [":nocoresight.fragment"],
        }),
)

genrule(
    name = "coresight_defconfig",
    srcs = [":coresightconfig"],
    outs = ["common/coresight.defconfig"],
    cmd = "cat $(SRCS) >> $(OUTS)",
)

filegroup(
    name = "kbaseconfig",
    srcs = ["midgard.fragment"] +
           select({
               "//private/google-modules/gpu/mali_kbase/config:mali_no_mali": ["nomali.fragment"],
               "//conditions:default": ["real_hw.fragment"],
           }) +
           select({
               "//private/google-modules/gpu/mali_kbase/config:mali_expert": ["mali_expert.fragment"],
               "//conditions:default": [],
           }) +
           select({
               "//private/google-modules/gpu/mali_kbase/config:mali_sync_file": ["sync_file.fragment"],
               "//conditions:default": [],
           }) +
           select({
               "//private/google-modules/gpu/mali_kbase/config:mali_debug": ["mali_debug.fragment"],
               "//conditions:default": [],
           }) +
           select({
               "//private/google-modules/gpu/mali_kbase/config:expert_no_mali": ["mali_expert_no_mali.fragment"],
               "//conditions:default": [],
           }) +
           select({
               "//private/google-modules/gpu/mali_kbase/config:mali_expert_debug": ["mali_expert_debug.fragment"],
               "//conditions:default": [],
           }) +
           select({
               "//private/google-modules/gpu/mali_kbase/config:mali_expert_debug_sync_file": ["mali_expert_debug_sync_file.fragment"],
               "//conditions:default": [],
           }) +
           select({
               "//private/google-modules/gpu/mali_kbase/config:mali_debug_kutf": ["debug_kutf.fragment"],
               "//conditions:default": [],
           }) +
           select({
               "//private/google-modules/gpu/mali_kbase/config:mali_coresight": ["coresight.fragment"],
               "//conditions:default": [],
           }) +
           select({
               "//private/google-modules/gpu/mali_kbase/config:midgard_dvfs": ["midgard_dvfs.fragment"],
               "//conditions:default": [],
           }) +
           select({
               "//private/google-modules/gpu/mali_kbase/config:mali_platform_name_meson": ["platform/meson.fragment"],
               "//private/google-modules/gpu/mali_kbase/config:mali_platform_name_vexpress": ["platform/vexpress.fragment"],
               "//private/google-modules/gpu/mali_kbase/config:mali_platform_name_vexpress_1xv7_a57": ["platform/vexpress_1xv7_a57.fragment"],
               "//private/google-modules/gpu/mali_kbase/config:mali_platform_name_vexpress_6xvirtex7_10mhz": ["platform/vexpress_6xvirtex7_10mhz.fragment"],
               "//conditions:default": [],
           }),
)

filegroup(
    name = "pixelconfig",
    srcs = select({
        "//private/google-modules/gpu/mali_kbase/config:mali_platform_name_pixel": ["pixel.fragment"],
        "//conditions:default": [],
    }) + select({
        "//private/google-modules/gpu/mali_kbase/config:mali_pixel_gpu_qos": ["mali_pixel_gpu_qos.fragment"],
        "//conditions:default": [],
    }) + select({
        "//private/google-modules/gpu/mali_kbase/config:mali_pixel_gpu_bts": ["mali_pixel_gpu_bts.fragment"],
        "//conditions:default": [],
    }) + select({
        "//private/google-modules/gpu/mali_kbase/config:mali_pixel_gpu_secure_rendering": ["mali_pixel_gpu_secure_rendering.fragment"],
        "//conditions:default": [],
    }) + select({
        "//private/google-modules/gpu/mali_kbase/config:mali_pixel_gpu_thermal": ["mali_pixel_gpu_thermal.fragment"],
        "//conditions:default": [],
    }) + select({
        "//private/google-modules/gpu/mali_kbase/config:mali_pixel_gpu_pm": ["mali_pixel_gpu_pm.fragment"],
        "//conditions:default": [],
    }) + select({
        "//private/google-modules/gpu/mali_kbase/config:mali_pixel_gpu_slc": ["mali_pixel_gpu_slc.fragment"],
        "//conditions:default": [],
    }) + select({
        "//private/google-modules/gpu/mali_kbase/config:mali_pixel_gpu_sscd": ["mali_pixel_gpu_sscd.fragment"],
        "//conditions:default": [],
    }) + select({
        "//private/google-modules/gpu/mali_kbase/config:pixel_and_kutf": ["pixel_and_kutf.fragment"],
        "//conditions:default": [],
    }),
)

genrule(
    name = "kbase_defconfig",
    srcs = [
        ":kbaseconfig",
        ":pixelconfig",
    ],
    outs = ["common/kbase.defconfig"],
    cmd = "cat $(SRCS) >> $(OUTS)",
)

filegroup(
    name = "kutf_defconfig",
    srcs = ["kutf.fragment"],
)
