load(
    "@kleaf//build/kernel/kleaf:kernel.bzl",
    "ddk_headers",
    "ddk_module",
)
load("//private/google-modules/gpu/mali_kbase/config:cflags.bzl", "CFLAGS_MODULE", "COPTS_KBASE", "COPTS_PIXEL")

package(default_visibility = [
    "//private/devices/google:__subpackages__",
    "//private/google-modules:__subpackages__",
])

filegroup(
    name = "kutf_kconfig",
    srcs = ["Kconfig"],
)

ddk_headers(
    name = "kutf_headers",
    hdrs = glob(["include/kutf/*.h"]),
    includes = ["include"],
)

ddk_module(
    name = "mali_kutf",
    srcs = [
        "kutf/kutf_helpers.c",
        "kutf/kutf_helpers_user.c",
        "kutf/kutf_kprobe.c",
        "kutf/kutf_mem.c",
        "kutf/kutf_resultset.c",
        "kutf/kutf_suite.c",
        "kutf/kutf_utils.c",
    ],
    out = "mali_kutf.ko",
    hdrs = [
        ":kutf_headers",
        "//private/google-modules/gpu/mali_kbase:mali_kernel_headers",
    ],
    copts = CFLAGS_MODULE + COPTS_KBASE + COPTS_PIXEL,
    defconfig = "//private/google-modules/gpu/mali_kbase/config/fragment:kbase_defconfig",
    kconfig = "//private/google-modules/gpu/mali_kbase:midgard_kconfig",
    kernel_build = "//private/devices/google/common:kernel",
)

ddk_module(
    name = "mali_kutf_irq_test",
    srcs = ["mali_kutf_irq_test/mali_kutf_irq_test_main.c"],
    out = "mali_kutf_irq_test.ko",
    hdrs = [
        ":kutf_headers",
        "//private/google-modules/gpu/mali_kbase:mali_kernel_headers",
    ],
    copts = CFLAGS_MODULE + COPTS_KBASE,
    defconfig = "//private/google-modules/gpu/mali_kbase/config/fragment:kbase_defconfig",
    kconfig = "//private/google-modules/gpu/mali_kbase:midgard_kconfig",
    kernel_build = "//private/devices/google/common:kernel",
    deps = [":mali_kutf"],
)

ddk_module(
    name = "mali_kutf_clk_rate_trace_test",
    srcs = ["mali_kutf_clk_rate_trace/kernel/mali_kutf_clk_rate_trace_test.c"],
    out = "mali_kutf_clk_rate_trace_test_portal.ko",
    hdrs = ["mali_kutf_clk_rate_trace/mali_kutf_clk_rate_trace_test.h"],
    copts = CFLAGS_MODULE + COPTS_KBASE + COPTS_PIXEL,
    defconfig = "//private/google-modules/gpu/mali_kbase/config/fragment:kbase_defconfig",
    kconfig = "//private/google-modules/gpu/mali_kbase:midgard_kconfig",
    kernel_build = "//private/devices/google/common:kernel",
    deps = [
        ":mali_kutf",
        "//private/google-modules/gpu/mali_kbase:mali_kbase_driver",
    ],
)

ddk_module(
    name = "mali_kutf_mgm_integration_test",
    srcs = ["mali_kutf_mgm_integration_test/mali_kutf_mgm_integration_test_main.c"],
    out = "mali_kutf_mgm_integration_test.ko",
    hdrs = ["//private/google-modules/gpu/mali_kbase:mali_kernel_headers"],
    copts = CFLAGS_MODULE + COPTS_KBASE,
    defconfig = "//private/google-modules/gpu/mali_kbase/config/fragment:kbase_defconfig",
    kconfig = "//private/google-modules/gpu/mali_kbase:midgard_kconfig",
    kernel_build = "//private/devices/google/common:kernel",
    deps = [":mali_kutf"],
)
