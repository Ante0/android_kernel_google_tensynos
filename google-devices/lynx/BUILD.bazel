        "//private/google-modules/wlan/qcom/wcn6740/cnss2:cnss2_cnss_prealloc",
        "//private/google-modules/wlan/qcom/wcn6740/cnss2:cnss2_cnss_utils",
        "//private/google-modules/wlan/qcom/wcn6740/cnss2:cnss2_mhi",
        "//private/google-modules/wlan/qcom/wcn6740/cnss2:cnss2_qmi",
