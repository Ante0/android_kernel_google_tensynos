        "//private/google-modules/amplifiers/cs40l26:cs40l26-i2c",
        "//private/google-modules/touch/goodix:goodix_brl_touch",
    ],
    # keep sorted
    vendor_ramdisk_modules = [
        "//private/devices/google/lynx/display:panel-samsung-s6e3fc3-l10",
        "//private/devices/google/lynx/display:panel-samsung-s6e3fc5",
