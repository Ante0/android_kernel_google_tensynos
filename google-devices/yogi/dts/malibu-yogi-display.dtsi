&lsioe_i2c4 {
	status = "ok";
	#address-cells = <1>;
	#size-cells = <0>;
	clock-frequency = <400000>;
	s2dos07x02_i2c9: s2dos07x02@60 {
		compatible = "samsung,s2dos07x02";
		reg = <0x60>;
		status = "okay";
		regulator-name = "s2dos07x02-pmic";
	};
};

&lsios_i2c4 {
	status = "okay";
	#address-cells = <1>;
	#size-cells = <0>;
	clock-frequency = <400000>;
	s2dos07x02_i2c4: s2dos07x02@60 {
		compatible = "samsung,s2dos07x02";
		reg = <0x60>;
		status = "okay";
		regulator-name = "s2dos07x02-pmic";
		regulator-max-microvolt = <2100000>;
		regulator-min-microvolt = <850000>;
	};
};

&gs_dsi0_connector {
	google,preferred-panel = <&google_gs_iyidb>;
	/* 0: primary, 1: secondary */
	google,device-index = <1>;

	google_gs_iyidb: panel-gs-iyidb {
		compatible = "google,gs-iyidb";
		label = "google-iyidb";
		channel = <0>;
		allowed-hs-clks = <865 756>;

		/* reset, power */
		reset-gpios = <PMICS2DISP0_RESET_L(GPIO_ACTIVE_HIGH)>;
		tpreset-gpios = <PMICS2TS0_RESET_L_1V2(GPIO_ACTIVE_HIGH)>;
		tout-gpios = <DISP0_2_AP_PROX0_TOUT(GPIO_ACTIVE_HIGH)>;
		vci-supply = <&ldo_18s_reg>;
		vddi-supply = <&buck_12s_reg>;
		vddd-supply = <&s2dos07x02_i2c9>;
		vddd-normal-microvolt = <987500>;
		vddd-lp-microvolt     = <987500>;

		pinctrl-names = "default", "sleep";
		pinctrl-0 = <&disp0pmic2aoss_int_od_l_1v2>;
		pinctrl-1 = <&disp0pmic2aoss_int_od_l_1v2_sleep>;

		/* PMIC IRQB interrupt */
		pmic_irq-gpio = <DISP0PMIC2AOSS_INT_OD_L_1V2(GPIO_ACTIVE_LOW)>;
		pmic-regmap = <&s2dos07x02_i2c9>;
	};
};

&gs_dsi1_connector {
	google,preferred-panel = <&google_gs_iyida>;
	/* 0: primary, 1: secondary */
	google,device-index = <0>;

	google_gs_iyida: panel-gs-iyida {
		compatible = "google,gs-iyida";
		label = "google-iyida";
		channel = <0>;
		/* 0: normal, 1: bottom up, 2: left up, 3: right up */
		orientation = <2>;
		allowed-hs-clks = <1468 1388>;

		/* reset, power */
		reset-gpios = <PMICS2DISP1_RESET_L(GPIO_ACTIVE_HIGH)>;
		tout-gpios = <DISP1_2_AP_PROX1_TOUT_1V2(GPIO_ACTIVE_HIGH)>;
		vci-supply = <&ldo_14m_reg>;
		vddi-supply = <&buck_12s_reg>;
		vddd-supply = <&s2dos07x02_i2c4>;
		vddd-normal-microvolt = <850000>;

		/* pinctrl */
		pinctrl-names = "default", "sleep";
		pinctrl-0 = <&disp1_2_ap_prox1_tout_1v2>, <&disp1pmic2aoss_int_od_l_1v2>;
		pinctrl-1 = <&disp1_2_ap_prox1_tout_1v2_sleep>,
			<&disp1pmic2aoss_int_od_l_1v2_sleep>;

		/* PMIC IRQB interrupt */
		pmic_irq-gpio = <DISP1PMIC2AOSS_INT_OD_L_1V2(GPIO_ACTIVE_LOW)>;
		pmic-regmap = <&s2dos07x02_i2c4>;

	};
};

&dsi2h0 {
	status = "ok";
	datarate = <865>;
};

&dsi2h1 {
	status = "ok";
	datarate = <1468>;
	hs_link_enable;
};
