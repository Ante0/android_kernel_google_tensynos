			};

			inner_front_camera_pwrseq: inner_front_camera_pwrseq@0 {
				compatible = "google,lwis-pwrseq-device";

				/* Device node name */
				node-name = "pwrseq-inner-fmain";
				/* Power sequence target name */
				target-name = "inner_front_camera";

				/* Sequencer sources */
				sequencer-sources = <&camera_base_pwrseq>;

				/* Power supplies */
				lvbuck-supply = <&cam_pp1150_lvbuck>;
				mvbuck-supply = <&cam_pp2450_mvbuck>;
				vio-supply = <&ldo_22s_reg>;
				vdda-supply = <&sgm38122_avdd1_csia>;
				vdig-supply = <&ldo_11s_reg>;

				/* MCLK Control */
				pinctrl-names = "mclk_on", "mclk_off";
				pinctrl-0 = <&ap2fcam1_mclk_24mhz>;
				pinctrl-1 = <&ap2fcam1_mclk_24mhz_sleep>;

				power-up-seqs =
