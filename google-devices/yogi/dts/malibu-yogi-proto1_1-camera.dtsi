					"regulator",
					"regulator",
					"regulator",
					"regulator",
					"regulator",
					"pinctrl";
				power-up-seq-delays-us =
					<0
					 0
					 0
					 2500
					 0
					 1000
					 1000>;

				power-down-seqs =
					"mclk_off",
					"vdig",
					"vdda",
					"vio",
					"lvbuck",
					"mvbuck",
					"camera_base";
				power-down-seq-types =
					"pinctrl",
					"regulator",
					"regulator",
					"regulator",
					"regulator",
					"regulator",
					"pwrseq";
				power-down-seq-delays-us =
					<1000
					 0
					 1000
					 200
					 0
					 200
					 0>;
