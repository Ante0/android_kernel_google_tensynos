			pathfinder1_outer_front_camera_power_seq: pathfinder1_module_power_seq@1 {
				/* Power up sequence */
				power-up-seqs =
					"shared-csimux_sel",
					"vio",
					"vdig",
					"afois_vana",
					"afois_vm",
					"shared-reset",
					"shared-afois-reset",
					"mclk_on",
					"resume";

				power-up-seq-types =
					"gpio",
					"regulator",
					"regulator",
					"regulator",
					"regulator",
					"gpio",
					"gpio",
					"pinctrl",
					"controller";
				power-up-seq-delays-us =
					<0
					 1000
					 1000
					 1000
					 1000
					 0
					 0
					 8000
					 0>;

				/* Power down sequence */
				power-down-seqs =
					"suspend",
					"mclk_off",
					"shared-afois-reset",
					"shared-reset",
					"afois_vm",
					"afois_vana",
					"vdig",
					"vio",
					"shared-csimux_sel";
				power-down-seq-types =
					"controller",
					"pinctrl",
					"gpio",
					"gpio",
					"regulator",
					"regulator",
					"regulator",
					"regulator",
					"gpio";
				power-down-seq-delays-us =
					<0
					 0
					 0
					 0
					 0
					 0
					 0
					 1000
					 0>;
			};

			/* CSIF DOKKAEBI with MUX on as OUTER FRONT */
			pathfinder1_sensor1: pathfinder1_sensor@1 {
				compatible = "google,lwis-i2c-device";

				/* Device node name */
