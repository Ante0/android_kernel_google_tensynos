				vana-supply = <&sgm38122_avdd3_csib>;
				vdig-supply = <&sgm38122_dvdd_csia>;
				vio-supply = <&ldo_22s_reg>;

				/* MCLK Control */
				pinctrl-names = "mclk_on", "mclk_off";
