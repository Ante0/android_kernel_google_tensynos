			/* IO EXPANDER 1 on NORTH_I2C */
			pathfinder1_io_expander0: pathfinder1_io_expander@0 {
				compatible = "google,lwis-i2c-device";

				/* Device node name */
				node-name = "io-pca6416-0";

				/* I2C */
				i2c-bus = <&lsioe_i2c0>;
				i2c-addr = <0x20>;

				/* Registers */
				reg-addr-bitwidth = <8>;
				reg-value-bitwidth = <8>;

				/* Power supplies */
				dvdd-supply = <&ldo_24m_reg>;

				power-up-seqs =
					"dvdd";
				power-up-seq-types =
					"regulator";
				power-up-seq-delays-us =
					<1000>;

				power-down-seqs =
					"dvdd";
				power-down-seq-types =
					"regulator";
				power-down-seq-delays-us =
					<1000>;

				i2c-lock-group-id = <6>;
			};

