				vdig-supply = <&sgm38122_dvdd_csif>;
				afois_vana-supply = <&sgm38122_avdd1_csif>;
				afois_vm-supply = <&sgm38122_avdd3_csif>;

				/* Power domains: cpm_clk */
				power-domains = <&sswrp_lsio_s_pd>;

				clocks = <&lsio_s_m5_clk>;
				clock-names = "MCLK5";
				clock-rates = <24576000>;

				/* MCLK Control */
				pinctrl-names = "mclk_on", "mclk_off";
				pinctrl-0 = <&ap2rtcam_mclk_24mhz>;
