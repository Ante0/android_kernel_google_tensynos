#include <dt-bindings/gpio/gpio.h>

&lsioe_i2c4 {
	status = "ok";
	#address-cells = <1>;
	#size-cells = <0>;
	clock-frequency = <400000>;
	s2dos07x02: s2dos07x02@60 {
		compatible = "samsung,s2dos07x02";
		reg = <0x60>;
		status = "okay";
		regulator-name = "s2dos07x02-pmic";
	};
};

&dpu {
	pinctrl-0 = <&disp0_2_ap_te>;
	pinctrl-names = "default";
};

&gs_dsi0_connector {
	google,preferred-panel = <&google_gs_cgyda>;

	google_gs_bzea: panel-gs-bzea {
		compatible = "google,gs-bzea";
		label = "google-bzea";
		channel = <0>;

		/* reset, power */
		reset-gpios = <PMICS2DISP0_RESET_L(GPIO_ACTIVE_HIGH)>;
		vci-supply = <&ldo_18s_reg>;
		vddi-supply = <&buck_12s_reg>;
		vddd-supply = <&s2dos07x02>;
		vddd-normal-microvolt = <887500>;
		vddd-lp-microvolt     = <862500>;
	};

	google_gs_cgyda: panel-gs-cgyda {
		compatible = "google,gs-cgyda";
		label = "google-cgyda";
		channel = <0>;
		allowed-hs-clks = <1390 1410>;

		/* reset, power */
		reset-gpios = <PMICS2DISP0_RESET_L(GPIO_ACTIVE_HIGH)>;
		tout-gpios = <DISP0_2_AP_PROX0_TOUT(GPIO_ACTIVE_HIGH)>;
		err_fg-gpios = <DISP0_2_AP_ERR_FG(GPIO_ACTIVE_HIGH)>;
		vci-supply = <&ldo_18s_reg>;
		vddi-supply = <&buck_12s_reg>;
		vddd-supply = <&s2dos07x02>;
		vddd-normal-microvolt = <887500>;
		vddd-lp-microvolt     = <862500>;

		pinctrl-names = "default", "sleep";
		pinctrl-0 = <&disp0pmic2aoss_int_od_l_1v2>;
		pinctrl-1 = <&disp0pmic2aoss_int_od_l_1v2_sleep>;

		/* PMIC IRQB interrupt */
		pmic_irq-gpio = <DISP0PMIC2AOSS_INT_OD_L_1V2(GPIO_ACTIVE_LOW)>;
		pmic-regmap = <&s2dos07x02>;
	};
};

&dsi2h0 {
	datarate = <1390>;
};
