#include <dt-bindings/interrupt-controller/irq.h>
#include <dt-bindings/lwis/platform/malibu/tof.h>

/ {
	fragment@rcam_supply {
		target-path = "/";
		__overlay__ {
			rcam_vana: rcam_supply@0 {
				compatible = "regulator-fixed";
				status = "okay";
				regulator-name = "PP2250_LDO1";
				regulator-min-microvolt = <2250000>;
				regulator-max-microvolt = <2250000>;
				/* 1ms */
				regulator-enable-ramp-delay = <1000>;
				enable-active-high;
				/* VANA_EN */
				gpio = <PMICM2RCAM_VANA_EN(GPIO_ACTIVE_HIGH)>;
			};

			rcam_vdig: rcam_supply@1 {
				compatible = "regulator-fixed";
				status = "okay";
				regulator-name = "PP0850_LVBUCK";
				regulator-min-microvolt = <850000>;
				regulator-max-microvolt = <850000>;
				/* 2ms */
				regulator-enable-ramp-delay = <2000>;
				enable-active-high;
				/* VDIG_EN */
				gpio = <PMICM2RCAM_VDIG_EN(GPIO_ACTIVE_HIGH)>;
			};
		};
	};
};

