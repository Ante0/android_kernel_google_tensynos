&lsios_i3c2 {
	#address-cells = <3>;
	#size-cells = <0>;
	i2c-shared-slot;

	/* Lwis placeholder for RCAM */
	csib_boitata_placeholder_i3c: csib_boitata_placeholder_i3c@0 {
		compatible = "google,lwis-placeholder";
		/* I2C */
		reg = <0x3D 0x0 0x20>;
	};
	csib_chemosh_placeholder_i3c: csib_chemosh_placeholder_i3c@0 {
		compatible = "google,lwis-placeholder";
		/* I2C */
		reg = <0x56 0x0 0x20>;
	};
	csib_cornerfolk_placeholder_i3c: csib_cornerfolk_placeholder_i3c@0 {
		compatible = "google,lwis-placeholder";
		/* I2C */
		reg = <0xC 0x0 0x20>;
	};
	csib_ois_placeholder_i3c: csib_ois_placeholder_i3c@0 {
		compatible = "google,lwis-placeholder";
		/* I2C */
		reg = <0x24 0x0 0x20>;
	};
	csib_vesta_ois_placeholder_i3c: csib_vesta_ois_placeholder_i3c@0 {
		compatible = "google,lwis-placeholder";
		/* I2C */
		reg = <0x3C 0x0 0x20>;
	};
	csib_vesta_eeprom_placeholder_i3c: csib_vesta_eeprom_placeholder_i3c@0 {
		compatible = "google,lwis-placeholder";
		/* I2C */
		reg = <0x51 0x0 0x20>;
	};
};

&lsios_spi1 {
	#address-cells = <1>;
	#size-cells = <0>;
	google,spi-gpio-cs-with-cpol-high;
	tof0: tof@0 {
		compatible = "google,lwis-spi-device";

		/* SPI_CONFIG */
		reg = <0>;
		spi-max-frequency = <20000000>;
		spi-cpol;
		spi-cpha;

		/* Device node name */
		node-name = "tof-tarasque";

		/* Registers */
		reg-addr-bitwidth = <16>;
		reg-value-bitwidth = <8>;

		/* MCLK Control */
		/* LWIS DT parser explicitly requires mclk_on pinctrl */
		pinctrl-names = "default", "mclk_on", "mclk_off";
		pinctrl-0 = <&ldaf2aoss_irq_od_l_1v2>;
		pinctrl-1 = <&ldaf2aoss_irq_od_l_1v2>;
		pinctrl-2 = <>;

		irq-gpios = <LDAF2AOSS_IRQ_OD_L_1V2(GPIO_ACTIVE_LOW)>;
		irq-gpios-names = "tof-irq";
		irq-gpios-events = <LWIS_PLATFORM_EVENT_ID_TOF_DATA_POLLING>;
		irq-gpios-types = <IRQ_TYPE_EDGE_FALLING>;

		/* Power supplies */
		/* VADD 3.3V */
		l27m-supply = <&ldo_27m_reg>;

		/* Power up sequence */
		power-up-seqs =
			"l27m",
			"mclk_on";
		power-up-seq-types =
			"regulator",
			"pinctrl";
		power-up-seq-delays-us =
			<0
			 0>;

		/* Power down sequence */
		power-down-seqs =
			"mclk_off",
			"l27m";
		power-down-seq-types =
			"pinctrl",
			"regulator";
		power-down-seq-delays-us =
			<0
			 0>;

		/* Thread priority */
		/* This is made to be lower than image sensor's thread */
		/* thread priority to allow uninterrupted image sensor */
		/* operation during periods of high CPU contention. */
		transaction-thread-priority = <100>;
	};
};

/ {
	fragment@lwiscamera {
		target-path = "/";
		__overlay__ {
			flash0: flash@0 {
				compatible = "google,lwis-i2c-device";

				/* Device node name */
				node-name = "flash-sy70206";

				/* I2C */
				i2c-bus = <&lsioe_i2c0>;
				i2c-addr = <0x63>;

				/* Registers */
				reg-addr-bitwidth = <8>;
				reg-value-bitwidth = <8>;

				/* Power supplies */
				bb_cam-supply = <&sy70206_reg>;

				power-up-seqs =
					"fast-bb_cam";
				power-up-seq-types =
					"regulator_mode";
				power-up-seq-delays-us =
					<0>;

				power-down-seqs =
					"normal-bb_cam";
				power-down-seq-types =
					"regulator_mode";
				power-down-seq-delays-us =
					<0>;

				/* Hax to let LWIS parse the regulator */
				/* resume sequence */
				resume-seqs = "bb_cam";
				resume-seq-types = "regulator";
				resume-seq-delays-us = <0>;

				/* suspend sequence */
				suspend-seqs = "bb_cam";
				suspend-seq-types = "regulator";
				suspend-seq-delays-us = <0>;
			};
		};
	};
};

