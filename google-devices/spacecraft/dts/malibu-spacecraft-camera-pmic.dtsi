				regulator-max-microvolt = <3424000>;
				in2-supply = <&camera_buck_boost>;
			};

			sgm38125_avdd2_csie: avdd2 {
				regulator-name = "avdd2";
				regulator-min-microvolt = <1504000>;
				regulator-max-microvolt = <3424000>;
				in2-supply = <&camera_buck_boost>;
			};

			sgm38125_avdd3_csie: avdd3 {
				regulator-name = "avdd3";
				regulator-min-microvolt = <1504000>;
				regulator-max-microvolt = <3424000>;
				in3-supply = <&cam_pp2500_mvbuck>;
			};
		};
	};

	sgm38125_csif: sgm38125@6E {
		compatible = "sgm,sgm38125";
		reg = <0x6E>;
		regulator-supply = <&camera_buck_boost>;
		status = "ok";

		regulators {
			sgm38125_dvdd_csif: dvdd {
				regulator-name = "dvdd";
				regulator-min-microvolt = <528000>;
				regulator-max-microvolt = <1800000>;
			};

			sgm38125_avdd1_csif: avdd1 {
				regulator-name = "avdd1";
				regulator-min-microvolt = <1504000>;
				regulator-max-microvolt = <3424000>;
				in2-supply = <&camera_buck_boost>;
			};

			sgm38125_avdd2_csif: avdd2 {
				regulator-name = "avdd2";
				regulator-min-microvolt = <1504000>;
				regulator-max-microvolt = <3424000>;
				in2-supply = <&camera_buck_boost>;
			};

			sgm38125_avdd3_csif: avdd3 {
				regulator-name = "avdd3";
				regulator-min-microvolt = <1504000>;
				regulator-max-microvolt = <3424000>;
			};
		};
	};
};

&lsioe_i2c3 {
	#address-cells = <1>;
	#size-cells = <0>;

	sgm38122_shared: sgm38122@29 {
		compatible = "sgm,sgm38122";
		reg = <0x29>;
		enable-supply = <&sy70206_reg>;
		status = "ok";

		regulators {
			sgm38122_dvdd_shared: dvdd {
				regulator-name = "dvdd";
				regulator-min-microvolt = <528000>;
				regulator-max-microvolt = <1800000>;
			};

			sgm38122_avdd1_shared: avdd1 {
				regulator-name = "avdd1";
				regulator-min-microvolt = <1504000>;
				regulator-max-microvolt = <3424000>;
			};

			sgm38122_avdd2_shared: avdd2 {
				regulator-name = "avdd2";
				regulator-min-microvolt = <1504000>;
				regulator-max-microvolt = <3424000>;
			};

			sgm38122_avdd3_shared: avdd3 {
				regulator-name = "avdd3";
				regulator-min-microvolt = <1504000>;
				regulator-max-microvolt = <3424000>;
			};
		};
	};
};

