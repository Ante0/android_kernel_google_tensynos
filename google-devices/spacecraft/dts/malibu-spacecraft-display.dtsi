#include <dt-bindings/gpio/gpio.h>


&lsioe_i2c4 {
	status = "ok";
	#address-cells = <1>;
	#size-cells = <0>;
	clock-frequency = <400000>;
	s2dos07x02: s2dos07x02@60 {
		compatible = "samsung,s2dos07x02";
		reg = <0x60>;
		status = "okay";
		regulator-name = "s2dos07x02-pmic";
	};
	tps628600: tps628600@40 {
		compatible = "ti,tps628600";
		reg = <0x40>;
		status = "okay";
		regulator-name = "tps628600-reg";
		enable-gpios = <PMICS2DISP0_BUCK_EN(GPIO_ACTIVE_HIGH)>;
	};
};

&dpu {
	pinctrl-0 = <&disp0_2_ap_te>;
	pinctrl-names = "default";
};

&gs_dsi0_connector {
	google,preferred-panel = <&google_gs_mtea>;

	google_gs_flea: panel-gs-flea {
		compatible = "google,gs-flea";
		label = "google-flea";
		channel = <0>;

		/* reset, power */
		reset-gpios = <PMICS2DISP0_RESET_L(GPIO_ACTIVE_HIGH)>;
		vci-supply = <&ldo_14m_reg>;
		vddi-supply = <&buck_12s_reg>;
		vddd-supply = <&tps628600>;
		vddd-normal-microvolt = <1000000>;
		vddd-lp-microvolt     = <962500>;
	};

	google_gs_dcsda: panel-gs-dcsda {
		compatible = "google,gs-dcsda";
		label = "google-dcsda";
		channel = <0>;
		allowed-hs-clks = <756 740>;

		/* reset, power */
		reset-gpios = <PMICS2DISP0_RESET_L(GPIO_ACTIVE_HIGH)>;
		vci-supply = <&ldo_14m_reg>;
		vddi-supply = <&buck_12s_reg>;
		vddd-supply = <&tps628600>;
		vddd-normal-microvolt = <1000000>;
		vddd-lp-microvolt     = <962500>;
	};

	google_gs_dcsdb: panel-gs-dcsdb {
		compatible = "google,gs-dcsdb";
		label = "google-dcsdb";
		channel = <0>;
		allowed-hs-clks = <756 740>;

		/* reset, power */
		reset-gpios = <PMICS2DISP0_RESET_L(GPIO_ACTIVE_HIGH)>;
		vci-supply = <&ldo_14m_reg>;
		vddi-supply = <&buck_12s_reg>;
		vddd-supply = <&tps628600>;
		vddd-normal-microvolt = <1112500>;
		vddd-lp-microvolt     = <1062500>;
	};

	google_gs_mtea: panel-gs-mtea {
		compatible = "google,gs-mtea";
		label = "google-mtea";
		channel = <0>;

		/* reset, power */
		reset-gpios = <PMICS2DISP0_RESET_L(GPIO_ACTIVE_HIGH)>;
		vci-supply = <&ldo_14m_reg>;
		vddi-supply = <&buck_12s_reg>;
		vddd-supply = <&s2dos07x02>;
		vddd-normal-microvolt = <887500>;
		vddd-lp-microvolt     = <862500>;
	};

	google_gs_pkkda: panel-gs-pkkda {
		compatible = "google,gs-pkkda";
		label = "google-pkkda";
		channel = <0>;
		allowed-hs-clks = <1368 1346>;

		/* reset, power */
		reset-gpios = <PMICS2DISP0_RESET_L(GPIO_ACTIVE_HIGH)>;
		vci-supply = <&ldo_14m_reg>;
		vddi-supply = <&buck_12s_reg>;
		vddd-supply = <&s2dos07x02>;
		vddd-normal-microvolt = <887500>;
		vddd-lp-microvolt     = <862500>;
	};

	google_gs_cgyda: panel-gs-cgyda {
		compatible = "google,gs-cgyda";
		label = "google-cgyda";
		channel = <0>;
		allowed-hs-clks = <1390 1410>;

		/* reset, power */
		reset-gpios = <PMICS2DISP0_RESET_L(GPIO_ACTIVE_HIGH)>;
		vci-supply = <&ldo_14m_reg>;
		vddi-supply = <&buck_12s_reg>;
		vddd-supply = <&s2dos07x02>;
		vddd-normal-microvolt = <887500>;
		vddd-lp-microvolt     = <862500>;
	};
};

&dsi2h0 {
	datarate = <1368>;
};
