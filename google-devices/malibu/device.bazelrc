build:malibu_base --//private/devices/google/common:soc=malibu
build:malibu_base --//private/google-modules/perf/core/gs_perf_domain:enable_perf_domain=True
build:malibu_base --//private/google-modules/perf/core/gs_perf_mon:enable_gs_perf_mon=True
build:malibu_base --//private/google-modules/perf/core/lat_govs:enable_lat_govs=True
build:malibu_base --//private/google-modules/radio/common/metrics_collection:metrics_collection=//private/google-modules/radio/common/metrics_collection:metrics_collection_enabled
build:malibu_base --//private/google-modules/soc/rdo/pci:google-pcie=//private/google-modules/soc/rdo/pci:google-pcie-v2
build:malibu_base --//private/google-modules/soc/rdo/mem-qos:enable_google-mem-qos=False


build:malibu --config=malibu_base
build:malibu --//private/devices/google/common:kernel=//private/devices/google/malibu:malibu/kernel
