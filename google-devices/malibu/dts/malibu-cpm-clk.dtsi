			lpcm-id = <LPCM_LSIO_S>;
			clock-id = <LSIO_S_M2_CLK>;
			rates = /bits/ 64 <24576000 38400000>;
		};

		lsio_s_m3_clk: lsio_s_m3_clk {
			#clock-cells = <0>;
			lpcm-id = <LPCM_LSIO_S>;
			clock-id = <LSIO_S_M3_CLK>;
			rates = /bits/ 64 <24576000 38400000>;
		};

		lsio_s_m4_clk: lsio_s_m4_clk {
