			lpcm-id = <LPCM_LSIO_S>;
			clock-id = <LSIO_S_M7_CLK>;
			rates = /bits/ 64 <24576000 38400000>;
		};

		lsio_s_i2c_0_clk: lsio_s_i2c_0_clk {
