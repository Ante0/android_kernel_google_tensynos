	gdmc_pinctrl: pinctrl@6480000 {
		compatible = "google,mbu-gdmc-pinctrl";
		reg = <0 0x6480000 0 0x15000>;

		gpio-controller;
		gpio-ranges = <&gdmc_pinctrl 0 0 21>;
		#gpio-cells = <2>;
		gpio-reserved-ranges = <7 8>;

		sswrp-wakeup-capable;

		interrupt-controller;
		#interrupt-cells = <2>;

		interrupts-extended =
			<&aoss_aon_multicast_aggr_4 AOSS_GIA_MULTICAST_AGGR_4__GDMC_AOSS_INTR_XGDMC_UART0_RXD_IRQ_0>,
			<&aoss_aon_multicast_aggr_4 AOSS_GIA_MULTICAST_AGGR_4__GDMC_AOSS_INTR_XGDMC_UART0_TXD_IRQ_0>,
			<&aoss_aon_multicast_aggr_4 AOSS_GIA_MULTICAST_AGGR_4__GDMC_AOSS_INTR_XGDMC_IN_DEBUG_1_IRQ_0>,
			<&aoss_aon_multicast_aggr_4 AOSS_GIA_MULTICAST_AGGR_4__GDMC_AOSS_INTR_XGDMC_IN_DEBUG_0_IRQ_0>,
			<&aoss_aon_multicast_aggr_4 AOSS_GIA_MULTICAST_AGGR_4__GDMC_AOSS_INTR_XGDMC_DEBUG_DEFAULT_0_IRQ_0>,
			<&aoss_aon_multicast_aggr_4 AOSS_GIA_MULTICAST_AGGR_4__GDMC_AOSS_INTR_XGDMC_CTI_0_IRQ_0>,
			<&aoss_aon_multicast_aggr_4 AOSS_GIA_MULTICAST_AGGR_4__GDMC_AOSS_INTR_XGDMC_CTI_1_IRQ_0>;
		irq-pad-mapping =
			<XGDMC_UART0_RXD>,
			<XGDMC_UART0_TXD>,
			<XGDMC_IN_DEBUG_1>,
			<XGDMC_IN_DEBUG_0>,
			<XGDMC_DEBUG_DEFAULT_0>,
			<XGDMC_CTI_0>,
			<XGDMC_CTI_1>;

	};

	pcie_pinctrl: pinctrl@49BE000 {
		compatible = "google,mbu-pcie-pinctrl";
		reg = <0 0x49BE000 0 0x5000>;

		gpio-controller;
