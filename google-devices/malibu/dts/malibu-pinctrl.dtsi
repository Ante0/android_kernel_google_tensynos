			<&lsios_multicast_aggr_3 LSIOS_GIA_MULTICAST_AGGR_3_AUX_AON_IOBANK_XLSIOS_SPIU1_SCLK_RTSN_IRQ>,
			<&lsios_multicast_aggr_3 LSIOS_GIA_MULTICAST_AGGR_3_AUX_AON_IOBANK_XLSIOS_SPIU1_MOSI_TXD_IRQ>,
