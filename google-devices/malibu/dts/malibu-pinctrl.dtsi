/{
	lsios_pinctrl: pinctrl@3BCE0000 {
		compatible = "google,mbu-lsios-pinctrl";
		reg = <0 0x3BCE0000 0 0x44000>;

		gpio-controller;
		gpio-ranges = <&lsios_pinctrl 0 0 68>;
		#gpio-cells = <2>;
		gpio-reserved-ranges = <51 1>;

		power-domains = <&lsio_s_cli_gpio_pd>;
		power-domain-names="csr_access_pd";

		interrupt-controller;
		#interrupt-cells = <2>;

		interrupts-extended =
			<&lsios_multicast_aggr_1 LSIOS_GIA_MULTICAST_AGGR_1_AUX_AON_IOBANK_XLSIOS_MCLK1_IRQ>,
			<&lsios_multicast_aggr_2 LSIOS_GIA_MULTICAST_AGGR_2_AUX_AON_IOBANK_XLSIOS_MCLK2_IRQ>,
