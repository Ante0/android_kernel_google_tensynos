/ {
	cpm_mba_syscon: cpm_mba_syscon@ea50000{
		compatible = "google,cpm-mba-global", "syscon";
		reg = <0x0 0x0ea50000 0x0 0x50>;
	};

	mba_aonss_sc_syscon: mba_aonss_sc_syscon@b9d0000 {
		compatible = "google,mba-aonss-sc-global", "syscon";
		reg = <0x0 0xb9d0000 0x0 0x1000>;
	};

	gdmc_mba_syscon: mba_cep_syscon@6250000 {
		compatible = "google,gdmc-mba-global", "syscon";
		reg = <0x0 0x6250000 0x0 0x1000>;
	};

	mba_aonss_sc_mba_client_0: mba_aonss_sc_mba_client_0@b9e0000 {
		compatible = "google,mba-ctrl";
		doorbell-mode;
		reg = <0x0 0xb9e0000 0x0 0x1000>;
		interrupts = <GIC_SPI SSWRP_AOSS_AOSS_AP_INTR_MBOX_0 IRQ_TYPE_LEVEL_HIGH 0>;
		#mbox-cells = <1>;
		google,syscon-phandle = <&mba_aonss_sc_syscon 0>;
		payload-size = <4>;
		status = "disabled";
	};

	mba_aonss_sc_mba_client_1: mba_aonss_sc_mba_client_1@b9e1000 {
		compatible = "google,mba-ctrl";
