		reg = <0x0 0x0ea60000 0x0 0x1000>;
		interrupts = <GIC_SPI SSWRP_AOSS_AOSS_AP_INTR_NS_CPM_REQ IRQ_TYPE_LEVEL_HIGH 0>;
		#mbox-cells = <1>;
		google,syscon-phandle = <&cpm_mba_syscon 0>;
		queue-mode;
		payload-size = <4>;
		mba-ip-version = <3 0>;
		status = "disabled";
	};

