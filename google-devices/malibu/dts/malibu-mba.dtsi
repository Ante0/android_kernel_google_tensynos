	goog_mba_aggr_gdmc: goog_mba_aggr_gdmc {
		compatible = "google,mba-aggr";
		service-name = "gdmc-normal";
		mboxes = <&gdmc_ap_non_secure_req_mba_client_2 0
			  &gdmc_ap1_req_mba_client_6 0
			  &gdmc_ap2_req_mba_client_8 0
			  &gdmc_ap3_req_mba_client_10 0
			  &gdmc_ap_non_secure_resp_mba_client_3 0
			  &gdmc_ap1_resp_mba_client_7 0
			  &gdmc_ap2_resp_mba_client_9 0
			  &gdmc_ap3_resp_mba_client_11 0>;
		req-mboxes-idx = <0 1 2 3>;
		resp-mboxes-idx = <4 5 6 7>;
		payload-size = <4>;
		status = "disabled";
	};

	goog_mba_aggr_gdmc_crit: goog_mba_aggr_gdmc_crit {
		compatible = "google,mba-aggr";
		service-name = "gdmc-critical";
		mboxes = <&gdmc_ap_critical_req_mba_client_4 0
			  &gdmc_ap_critical_resp_mba_client_5 0>;
		req-mboxes-idx = <0>;
		resp-mboxes-idx = <1>;
		payload-size = <4>;
		status = "disabled";
	};

	goog_mba_gdmc_iface: goog_mba_gdmc_iface {
		compatible = "google,mba-gdmc-iface";
		memory-region = <&goog_mba_gdmc_iface_dma_region>;
		goog-mba-aggrs = <&goog_mba_aggr_gdmc &goog_mba_aggr_gdmc_crit>;
		status = "disabled";
	};

	goog_mba_gdmc_iface_test: goog_mba_gdmc_iface_test {
		compatible = "google,mba-gdmc-iface-test";
		gdmc-iface = <&goog_mba_gdmc_iface>;
		status = "disabled";
	};

	mba_gsa_syscon: mba_gsa_syscon@5a00000 {
		compatible = "google,mba-gsa-client-csr-global", "syscon";
		reg = <0x0 0x5a00000 0x0 0x1000>;
	};

	mba_gsa_client_0_syscon: mba_gsa_client_0_syscon@5a10000 {
		compatible = "google,mba-gsa-client-csr", "syscon";
		reg = <0x0 0x5a10000 0x0 0x1000>;
	};

	mba_gsa_client_0: mba_gsa_client_0 {
		compatible = "google,mba-ctrl";
		interrupts = <GIC_SPI SSWRP_GSA_GSA_AP_INTR_MAILBOX_AP_CLIENT_IRQ_0
			      IRQ_TYPE_LEVEL_HIGH 0>;
		#mbox-cells = <1>;
		google,syscon-phandle = <&mba_gsa_syscon 0>;
		google,syscon-client-phandle = <&mba_gsa_client_0_syscon>;
		status = "disabled";
	};

	mba_gsa_client_0_doorbell: mba_gsa_client_0_doorbell {
		compatible = "google,mba-ctrl";
		interrupts = <GIC_SPI SSWRP_GSA_GSA_AP_INTR_MAILBOX_AP_CLIENT_IRQ_1
			      IRQ_TYPE_LEVEL_HIGH 0>;
		#mbox-cells = <1>;
		google,syscon-phandle = <&mba_gsa_syscon 0>;
		google,syscon-client-phandle = <&mba_gsa_client_0_syscon>;
		doorbell-mode;
		status = "disabled";
	};
