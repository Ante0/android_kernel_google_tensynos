		compatible = "google,mba-ctrl";
		reg = <0x0 0x0ea61000 0x0 0x1000>;
		interrupts = <GIC_SPI SSWRP_AOSS_AOSS_AP_INTR_NS_CPM_RESP IRQ_TYPE_LEVEL_HIGH 0>;
		#mbox-cells = <1>;
		google,syscon-phandle = <&cpm_mba_syscon 1>;
		queue-mode;
		payload-size = <4>;
		mba-ip-version = <3 0>;
		status = "disabled";
	};

	goog_mba_cpm_iface: goog_mba_cpm_iface {
		compatible = "google,mba-cpm-iface";
		mboxes = <&cpm_ap_ns_req_mba_client_0 0
			  &cpm_ap_ns_req_mba_client_0 1
			  &cpm_ap_ns_req_mba_client_0 2
			  &cpm_ap_ns_req_mba_client_0 3
			  &cpm_ap_ns_req_mba_client_0 4
			  &cpm_ap_ns_req_mba_client_0 5
			  &cpm_ap_ns_req_mba_client_0 6
			  &cpm_ap_ns_req_mba_client_0 7
			  &cpm_ap_ns_resp_mba_client_1 0
			  &cpm_ap_ns_resp_mba_client_1 1
			  &cpm_ap_ns_resp_mba_client_1 2
			  &cpm_ap_ns_resp_mba_client_1 3>;
		#mbox-cells = <0>;
		req-mboxes-idx = <0 1 2 3 4 5 6 7>;
		resp-mboxes-idx = <8 9 10 11>;
		payload-size = <4>;
		status = "disabled";
	};

	goog_mba_cpm_iface_test: goog_mba_cpm_iface_test {
		compatible = "google,mba-cpm-iface-test";
		mboxes = <&goog_mba_cpm_iface>;
		status = "disabled";
