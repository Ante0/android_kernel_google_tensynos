					type = "active";
				};
				mid_hot: mid-hot {
					temperature = <120000>;
					hysteresis = <3000>;
					type = "hot";
				};
			};

			tmu {
				polling-delay-on = <5>;

				/* PI control param */
				pi-enable;
				k-po = <68>;
				k-pu = <68>;
				k-i = <50>;

				/* early throttle param */
