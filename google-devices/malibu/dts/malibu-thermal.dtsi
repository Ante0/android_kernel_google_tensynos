				/* Tj control offset - mC */
			};
		};

		aoss_thermal: AOSS {
			polling-delay = <0>;
			polling-delay-passive = <0>;
			thermal-sensors = <&tmu_thermal TZ_AOSS>;

			trips {
				aoss_cold: aoss-cold {
					temperature = <12000>;
					hysteresis = <5000>;
					type = "active";
				};
				aoss_alert1: aoss-alert1 {
					temperature = <70000>;
					hysteresis = <5000>;
					type = "passive";
				};
				aoss_alert2: aoss-alert2 {
					temperature = <90000>;
					hysteresis = <5000>;
					type = "passive";
				};
				aoss_alert3: aoss-alert3 {
					temperature = <95000>;
					hysteresis = <4000>;
					type = "passive";
				};
				aoss_alert4: aoss-alert4 {
					temperature = <98000>;
					hysteresis = <98000>;
					type = "passive";
				};
				aoss_alert5: aoss-alert5 {
					temperature = <102000>;
					hysteresis = <102000>;
					type = "passive";
				};
				aoss_alert6: aoss-alert6 {
					temperature = <105000>;
					hysteresis = <105000>;
					type = "passive";
				};
				aoss_hot: aoss-hot {
					temperature = <115000>;
					hysteresis = <3000>;
					type = "hot";
				};
			};

			tmu {
				polling-delay-on = <25>;

				/* PI control param */
				/* early throttle param */
				/* gradual param */
				/* hardlimit param */

				/* Tj control offset - mC */
			};
		};

	};

	powercap_tree: powercap-tree {
		compatible = "google,powercap-tree";

		package {
			google,node-type = <GPOWERCAP_NODE_VIRTUAL>;

			powercap_soc: soc {
				google,node-type = <GPOWERCAP_NODE_VIRTUAL_WEIGHTS>;
				power-distribution-weights = "cpu_gpu_tpu", "5",
								"aurora", "1";

				cpu_gpu_tpu {
					google,node-type = <GPOWERCAP_NODE_VIRTUAL_WEIGHTS>;
					power-distribution-weights = "cpu_cluster", "3",
									"gpu", "1",
									"tpu", "1";

					cpu_cluster {
						google,node-type = <GPOWERCAP_NODE_VIRTUAL_WEIGHTS>;
						power-distribution-weights = "cpufreq-cpu0", "1",
										"cpufreq-cpu2", "1",
										"cpufreq-cpu6", "1";

						midll-cluster {
							google,node-type = <GPOWERCAP_NODE_CPU>;
							google,device-phandle = <&gelas_ll_0>;
							google,cdev-id = <HW_DT_CDEV_MIDLL>;
							odpm-rail-name = "S13M_VDD_CPU0";
							polling-interval-ms = <0>;
						};

						mid-cluster {
							google,node-type = <GPOWERCAP_NODE_CPU>;
							google,device-phandle = <&gelas_0>;
							google,cdev-id = <HW_DT_CDEV_MID>;
							odpm-rail-name = "S3M_VDD_CPU1";
							polling-interval-ms = <0>;
						};

						powercap_big_cluster: big-cluster {
							google,node-type = <GPOWERCAP_NODE_CPU>;
							google,device-phandle = <&travis_0>;
							google,cdev-id = <HW_DT_CDEV_BIG>;
							odpm-rail-name = "S2M_VDD_CPU2";
							polling-interval-ms = <0>;
						};
					};

					gpu {
						google,node-type = <GPOWERCAP_NODE_DEVFREQ>;
						google,device-phandle = <&gpu>;
						google,cdev-id = <HW_DT_CDEV_GPU>;
						odpm-rail-name = "S2S_VDD_GPU";
						polling-interval-ms = <0>;
					};

					tpu {
						google,node-type = <GPOWERCAP_NODE_DEVFREQ>;
						google,device-phandle = <&edgetpu>;
						google,cdev-id = <HW_DT_CDEV_TPU>;
						odpm-rail-name = "S7M_VDD_TPU";
						polling-interval-ms = <0>;
					};
				};

				aur {
					google,node-type = <GPOWERCAP_NODE_DEVFREQ>;
					google,device-phandle = <&gxp>;
					google,cdev-id = <HW_DT_CDEV_AUR>;
					odpm-rail-name = "S4M_VDD_AUR";
					polling-interval-ms = <0>;
				};
			};
		};
	};
};
