#include <dt-bindings/soc/google/google-thermal-def.h>

/ {
	ntc_thermal: ntc_thermal {
		compatible = "google,ntc-thermal";
		#thermal-sensor-cells = <1>;
		filter-spurious-samples;
		enable-hw-lpf;
	};

	thermal_uclamp: thermal_uclamp {
		compatible = "google,thermal-uclamp";
		google,cluster-cdev-map =
			< &gelas_ll_0 HW_DT_CDEV_MIDLL >,
			< &gelas_0    HW_DT_CDEV_MID >,
			< &travis_0   HW_DT_CDEV_BIG >;
	};

	tmu_thermal: tmu_thermal {
		compatible = "google,tmu-thermal";
		#thermal-sensor-cells = <1>;
	};

	thermal_cpm_mbox: thermal_cpm_mbox {
		compatible = "thermal-cpm-mbox";
		mba-dest-channel = <MBOX_DEST_CHAN_THERMAL>;
		mboxes = <&goog_mba_cpm_iface>;
	};

	thermal_devfreq_cdev {
		compatible = "google,devfreq-tj-cdev";
		thermal-hw-cdev-id = <HW_DT_CDEV_GPU>;
		thermal-devfreq = <&gpu>;
	};

	tmu_thermal_stats: tmu_thermal_stats {
		compatible = "google,tmu-stats";
		group-name = "tmu";
	};

	thermal_pressure: thermal_pressure {
		compatible = "google,thermal-pressure-tj";
		group-name = "tmu";

		active-polling-delay-ms = <100>;
		passive-polling-delay-ms = <2500>;

		cluster_config {
			thermal-pressure-big {
				first-cpu = <&travis_0>;
				cdev-id = <HW_DT_CDEV_BIG>;
			};
			thermal-pressure-mid {
				first-cpu = <&gelas_0>;
				cdev-id = <HW_DT_CDEV_MID>;
			};
			thermal-pressure-midll {
				first-cpu = <&gelas_ll_0>;
				cdev-id = <HW_DT_CDEV_MIDLL>;
			};
		};
	};

	thermal_zones_malibu: thermal-zones {
		big_thermal: BIG {
			polling-delay = <0>;
			polling-delay-passive = <0>;
			thermal-sensors = <&tmu_thermal TZ_BIG>;

			trips {
				big_cold: big-cold {
					temperature = <20000>;
					hysteresis = <5000>;
					type = "active";
				};
				big_switch_on: big-switch-on {
					temperature = <60000>;
					hysteresis = <5000>;
					type = "active";
				};
				big_early_throttle: big-early_throttle {
					temperature = <120000>;
					hysteresis = <5000>;
					type = "active";
				};
				big_control_temp: big-control-temp {
					temperature = <95000>;
					hysteresis = <5000>;
					type = "passive";
				};
				big_alert1: big-alert1 {
					temperature = <97000>;
					hysteresis = <5000>;
					type = "active";
				};
				big_sw_max_effort: big-sw-max-effort {
					temperature = <107000>;
					hysteresis = <2000>;
					type = "active";
				};
				big_dfs: big-dfs {
					temperature = <102000>;
					hysteresis = <5000>;
					type = "active";
				};
				big_hot: big-hot {
					temperature = <120000>;
					hysteresis = <3000>;
					type = "hot";
				};
			};

			tmu {
				polling-delay-on = <5>;

				/* PI control param */
				pi-enable;
				k-po = <68>;
				k-pu = <68>;
				k-i = <50>;

				/* early throttle param */
				early-throttle-k-p = <50>;

				/* gradual param */
				irq-gradual-gain = <2>;
				timer-gradual-gain = <1>;

				/* hardlimit param */
				hardlimit-enable;
				hardlimit-via-pid-enable;

				/* temp lut param */
				temp-lut-enable;
				temp-state-table =
					//	temp	state
					<	60	0
						255	4 >;

				/* Tj control offset - mC */
				junction-offset = <0 (-10000) (-10000) (-10000) 5000 0 0 0>;
			};
		};

		mid_thermal: MID {
			polling-delay = <0>;
			polling-delay-passive = <0>;
			thermal-sensors = <&tmu_thermal TZ_MID>;

			trips {
				mid_cold: mid-cold {
					temperature = <20000>;
					hysteresis = <5000>;
					type = "active";
				};
				mid_switch_on: mid-switch-on {
