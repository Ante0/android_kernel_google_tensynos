					hysteresis = <5000>;
					type = "active";
				};
				mid_sw_max_effort: mid-sw-max-effort {
					temperature = <110000>;
					hysteresis = <2000>;
					type = "active";
				};
				mid_dfs: mid-dfs {
					temperature = <105000>;
