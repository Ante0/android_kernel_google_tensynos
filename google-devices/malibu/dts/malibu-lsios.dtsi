	lsios_i2c0: i2c@3bdca000 {
		compatible = "google,i2c";
		reg = <0x0 0x3bdca000 0x0 0x100>;
		i2c-sda-hold-time-ns = <5>;
		interrupts-extended = <&lsios_multicast_aggr_1 LSIOS_GIA_MULTICAST_AGGR_1_IP_TOP_I2C_0_IC_INTR>;
		clocks = <&lsio_s_i2c_0_clk>,
			 <&lsio_s_i2c_0_cfg_clk>;
		clock-names = "ic_clk", "pclk";
		resets = <&lsio_s_resets RST_LSIO_S_I2C_0_PERI_CFG_CLK>;
		reset-names = "ic_rst";
		power-domains = <&lsio_s_cli_gpio_pd>;
		pinctrl-0 = <&lsios_i2c0_2_wire_func>;
		pinctrl-1 = <&lsios_i2c0_2_wire_sleep>;
		pinctrl-names = "default", "sleep";
		status = "disabled";
	};

