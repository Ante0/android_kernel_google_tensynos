	spmi_cpm: spmi@ebf1000 {
		compatible = "google,smartdv-spmi";
		reg = <0x0 0xebf1000 0x0 0x100>,
		      <0x0 0xeb82014 0x0 0x4>;
		clock-frequency = <19000000>;
		master_arb_en = <0>;
		master_id = <0>;
		spmi_ver = <1>;
		arb_retry_limit = <6>;
		prescalar = <0x0>;
		read_latancy = <0>;
		arb_scl_delay = <0>;
		status = "disabled";
	};

	pwm0: pwm@3bdb2000 {
		compatible = "faraday,ftpwmtmr010";
		reg = <0x0 0x3bdb2000 0x0 0x94>;
		interrupts-extended =	<&lsios_multicast_aggr_2 LSIOS_GIA_MULTICAST_AGGR_2_IP_TOP_PWM_TMR1_INTR>,
					<&lsios_multicast_aggr_2 LSIOS_GIA_MULTICAST_AGGR_2_IP_TOP_PWM_TMR2_INTR>,
					<&lsios_multicast_aggr_2 LSIOS_GIA_MULTICAST_AGGR_2_IP_TOP_PWM_TMR3_INTR>,
					<&lsios_multicast_aggr_2 LSIOS_GIA_MULTICAST_AGGR_2_IP_TOP_PWM_TMR4_INTR>;
		clocks = <&lsio_s_pwm_cfg_clk>, <&lsio_s_pwm_clk>;
		clock-names = "pclk", "ext_clk";
		resets = <&lsio_s_resets RST_LSIO_S_CG_PWM_CFG_CLK>, <&lsio_s_resets RST_LSIO_S_CG_PWM_CLK>;
		reset-names = "pwm_cfg", "pwm";
		power-domains = <&lsio_s_cli_gpio_pd>;
		pinctrl-0 = <&pwm0_func>, <&pwm1_func>, <&pwm2_func>, <&pwm3_func>;
		pinctrl-1 = <&pwm0_sleep>, <&pwm1_sleep>, <&pwm2_sleep>, <&pwm3_sleep>;
		pinctrl-names = "default", "sleep";
		#pwm-cells = <2>;
		status = "disabled";
	};
};
