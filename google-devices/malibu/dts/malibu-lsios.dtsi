		clocks = <&aoss_pg_amb_spi2_peri_clk>,
			 <&aoss_pg_amb_spi2_apb_clk>;
		clock-names = "ssi_clk", "pclk";
		resets = <&aoss_pg_amb_resets RST_AOSS_PG_AMB_SPI2_PERI_CFG_CLK>;
		reset-names = "spi";
		power-domains = <&sswrp_aoss_pg_pd>;
		pinctrl-0 = <&aoss_pg_spi1_clk_mosi_miso_func>, <&aoss_pg_spi1_cs_gpio_func>;
		pinctrl-1 = <&aoss_pg_spi1_sleep>;
		cs-gpios = <&aoss_pinctrl XAOSS_AMB_SPI2_CSn GPIO_ACTIVE_LOW>;
		pinctrl-names = "default", "sleep";
		status = "disabled";
	};

