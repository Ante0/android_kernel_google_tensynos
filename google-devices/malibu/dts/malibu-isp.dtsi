#include <dt-bindings/interconnect/google,mbu.h>
#include <dt-bindings/iis/google,mbu.h>

#include "malibu-isp-event-info.dtsi"
#include "malibu-gia-isp.dtsi"

/ {
	lwis_top: lwis_top {
		compatible = "google,lwis-top-device";

		/* Device node name */
		node-name = "top";

		/* Thread priority */
		transaction-thread-priority = <99>;
	};

	lwis_top_ccu: lwis_top_ccu {
		compatible = "google,lwis-top-device";

		/* Device node name */
		node-name = "top-ccu";
	};

	lwis_dpm: lwis_dpm@0 {
		compatible = "google,lwis-dpm-device";

		/* Device node name */
		node-name = "dpm";
	};

	lwis_test: lwis_test@0 {
		compatible = "google,lwis-test-device";

		/* Device node name */
		node-name = "test";

		/* Register space */
		reg = <0x0 0x0 0x0 0x20>;
		reg-names = "test";
		interrupt-names = "test_event_inj";
		interrupt-event-infos = <&test_event_inj>;
	};

	sswrp_ispfe: sswrp_ispfe@3E000000 {
		compatible = "simple-bus";
		#address-cells = <2>;
		#size-cells = <1>;
		ranges = <0x0 0x0 0x0 0x3E000000 0x1000000>;

		lwis_ispfe_top: lwis_ispfe_top@0 {
			compatible = "google,lwis-ioreg-device";

			/* Device node name */
			node-name = "ispfe-top";

			/* Register space */
			reg = <0x0 0x0 0x1000000>;
			reg-names = "ispfe";
			reg-valid-ranges =
				<0x0 0x9000 0x1c424>,		/* lpcm_ispfe_csr */
				<0x0 0x240000 0xfc14>,		/* ispfe_gpcsr */
				<0x0 0x280000 0x20000>,		/* fe_lite_core_sec0 */
				<0x0 0x2a0000 0x20000>,		/* fe_lite_core_sec1 */
				<0x0 0x2c0000 0x20000>, 	/* fe_core_sec0 */
				<0x0 0x2e0000 0x20000>, 	/* fe_core_sec1 */
				<0x0 0x300000 0x20000>, 	/* fe_core_sec2 */
				<0x0 0x340000 0x1118>,		/* tbu_wrapper_core_csr_0 */
				<0x0 0x360000 0x1118>,		/* tbu_wrapper_core_csr_1 */
				<0x0 0x380000 0x1118>,		/* tbu_wrapper_core_csr_2 */
				<0x0 0x800000 0x100000>,	/* fe_lite_core_0 */
				<0x0 0x900000 0x100000>;	/* fe_lite_core_1 */

			power-domains = <&sswrp_ispfe_pd>;

			device-group = <1>;

			interrupts-extended =
				<&ispfe_lite_core_0_level_aggr_0 14>,
				<&ispfe_lite_core_0_level_aggr_0 0>,
				<&ispfe_lite_core_0_level_aggr_0 1>,
				<&ispfe_lite_core_0_level_aggr_0 2>,
				<&ispfe_lite_core_0_level_aggr_0 8>,
				<&ispfe_lite_core_0_level_aggr_0 9>,
				<&ispfe_lite_core_0_level_aggr_0 10>,
				<&ispfe_lite_core_1_level_aggr_0 14>,
				<&ispfe_lite_core_1_level_aggr_0 0>,
				<&ispfe_lite_core_1_level_aggr_0 1>,
				<&ispfe_lite_core_1_level_aggr_0 2>,
				<&ispfe_lite_core_1_level_aggr_0 8>,
				<&ispfe_lite_core_1_level_aggr_0 9>,
				<&ispfe_lite_core_1_level_aggr_0 10>;
			interrupt-names =
				"isp_fe_core0_lite_core_top",
				"isp_fe_core0_lite_core_error_0",
				"isp_fe_core0_lite_core_error_1",
				"isp_fe_core0_lite_core_error_2",
				"isp_fe_core0_lite_core_misc_0",
				"isp_fe_core0_lite_core_misc_1",
				"isp_fe_core0_lite_core_rstctl",
				"isp_fe_core1_lite_core_top",
				"isp_fe_core1_lite_core_error_0",
				"isp_fe_core1_lite_core_error_1",
				"isp_fe_core1_lite_core_error_2",
				"isp_fe_core1_lite_core_misc_0",
				"isp_fe_core1_lite_core_misc_1",
				"isp_fe_core1_lite_core_rstctl";
			interrupt-event-infos =
				<&isp_fe_core0_lite_core_top>,
				<&isp_fe_core0_lite_core_error_0>,
				<&isp_fe_core0_lite_core_error_1>,
				<&isp_fe_core0_lite_core_error_2>,
				<&isp_fe_core0_lite_core_misc_0>,
				<&isp_fe_core0_lite_core_misc_1>,
				<&isp_fe_core0_lite_core_rstctl>,
				<&isp_fe_core1_lite_core_top>,
				<&isp_fe_core1_lite_core_error_0>,
				<&isp_fe_core1_lite_core_error_1>,
				<&isp_fe_core1_lite_core_error_2>,
				<&isp_fe_core1_lite_core_misc_0>,
				<&isp_fe_core1_lite_core_misc_1>,
				<&isp_fe_core1_lite_core_rstctl>;

			iommus =
				/* SEQ_ID 0 for Sensor IF #0 */
				<&med_smmu 0x9000>,
				<&med_smmu 0x9001>,
				<&med_smmu 0x9002>,
				<&med_smmu 0x9003>,
				<&med_smmu 0x9004>,
