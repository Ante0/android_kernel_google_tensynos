				<&med_smmu 0x920d>,
				/* SEQ_ID 1 for Sensor IF #1 */
				<&med_smmu 0x9010>,
				<&med_smmu 0x9011>,
				<&med_smmu 0x9012>,
				<&med_smmu 0x9013>,
