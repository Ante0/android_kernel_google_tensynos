/*
 * Water Intrusion Detection Sensor
 *
 * Copyright 2025 Google LLC
 *
 */

&max77779_i2cm {
	h2omg@70 {
		reg = <0x70>;
		compatible = "google,h2omg";
		control = /bits/ 8 <0x47>;

		pinctrl-names = "default";
		pinctrl-0 = <&drip2aoss_int_od_l_1v2>;
		h2omg_irq-gpios = <DRIP2AOSS_INT_OD_L_1V2(GPIO_ACTIVE_LOW)>;

		/* board divides the vref input */
		vref_div;

		/* require both sensors to trigger fuse */
		dual-trigger;
		/* if one sensor is wet longer than 5 m blow fuse */
		trigger_delay_ms = <90000>; /* 90 sec */
	};

	h2omg@71 {
		reg = <0x71>;
		compatible = "google,h2omg";

		control = /bits/ 8 <0x47>;
		pinctrl-names = "default";
		pinctrl-0 = <&drip2aoss_int_od_l_1v2>;
		h2omg_irq-gpios = <DRIP2AOSS_INT_OD_L_1V2(GPIO_ACTIVE_LOW)>;

		/* board divides the vref input */
		vref_div;

		/* require both sensors to trigger fuse */
		dual-trigger;
		/* if one sensor is wet longer than 5 m blow fuse */
		trigger_delay_ms = <90000>; /* 90 sec */
	};
};
