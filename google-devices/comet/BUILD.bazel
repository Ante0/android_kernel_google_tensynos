load("@kleaf//build/kernel/kleaf:kernel.bzl", "checkpatch")
load("//private/devices/google/common/kleaf:device_build.bzl", "device_build")
load("//private/devices/google/zuma:constants.bzl", "ZUMA_DTBS")
load("//private/devices/google/zumapro:constants.bzl", "ZUMAPRO_DTBS", "ZUMAPRO_MODULE_OUTS")
load(":constants.bzl", "COMET_DTBOS")

checkpatch(
    name = "checkpatch",
    checkpatch_pl = "//common:scripts/checkpatch.pl",
)

device_build(
    name = "comet",
    base_device = "//private/devices/google/zumapro:zumapro_base",
    build_configs = ["build.config.comet"],
    build_dtb = True,
    build_dtbo = True,
    build_system_dlkm = True,
    build_vendor_dlkm = True,
    build_vendor_kernel_boot = True,
    defconfig_fragments = ["comet_defconfig"],
    dtb_outs = ZUMA_DTBS + ZUMAPRO_DTBS,
    dtbo_outs = COMET_DTBOS,
    dts_makefile = "dts/Makefile",
    dts_srcs = glob(["dts/**"]) + [
        "//private/google-modules/soc/gs:gs.dt-bindings",
    ],
    insmod_cfgs = glob(["insmod_cfg/*.cfg"]),
    kconfig_exts = ["Kconfig.ext.comet"],
    kconfigs = [
        # keep sorted
        "//private/google-modules/radio/samsung/s5400:cpif.kconfig",
        "//private/google-modules/touch/sec/legacy:sec.kconfig",
    ],
    module_outs = ZUMAPRO_MODULE_OUTS,
    vendor_dlkm_modules = [
        # keep sorted
        "//private/google-modules/amplifiers/cs35l41:snd-soc-cs35l41",
        "//private/google-modules/amplifiers/cs35l41:snd-soc-cs35l41-i2c",
        "//private/google-modules/amplifiers/cs35l41:snd-soc-cs35l41-spi",
        "//private/google-modules/amplifiers/cs40l26:cl_dsp-core",
        "//private/google-modules/amplifiers/cs40l26:cs40l26-core",
        "//private/google-modules/amplifiers/cs40l26:snd-soc-cs40l26",
        "//private/google-modules/amplifiers/snd_soc_wm_adsp:snd-soc-wm-adsp",
        "//private/google-modules/bluetooth/broadcom:nitrous",
        "//private/google-modules/fingerprint/fpc:fpc1020_platform_tee",
        "//private/google-modules/gps/broadcom/bcm47765:bbd_pps_gpio",
        "//private/google-modules/nfc/ese:st33spi",
        "//private/google-modules/radio/samsung/s5400:cp_thermal_zone",
        "//private/google-modules/uwb/qorvo/qm35/qm35s:qm35",
        "//private/google-modules/wlan/wlan_ptracker",
        "//private/google-modules/wlan/wonder",
    ],
    vendor_dlkm_modules_blocklisted = [
        # keep sorted
        "//private/google-modules/amplifiers/cs40l26:cs40l26-i2c",
        "//private/google-modules/soc/gs/drivers/pwm:pwm-exynos",
        "//private/google-modules/soc/gs/drivers/video/backlight:rt4539_bl",
        "//private/google-modules/touch/goodix:goodix_brl_touch",
        "//private/google-modules/touch/sec/legacy:sec_touch",
        "//private/google-modules/touch/synaptics/syna_gtd:syna_touch",
        "//private/google-modules/wlan/bcmdhd/bcm4390:bcmdhd4390",
    ],
    vendor_ramdisk_modules = [
        # keep sorted
        "//private/devices/google/comet/display:panel-gs-ct3a",
        "//private/devices/google/comet/display:panel-gs-ct3b",
        "//private/devices/google/comet/display:panel-gs-ct3c",
        "//private/devices/google/comet/display:panel-gs-ct3d",
        "//private/devices/google/comet/display:panel-gs-ct3e",
        "//private/google-modules/gps/broadcom/bcm47765:bcm47765_ko",
        "//private/google-modules/nfc:st21nfc",
        "//private/google-modules/nfc/ese:st54spi",
        "//private/google-modules/radio/samsung/s5400:cp_pmic",
        "//private/google-modules/radio/samsung/s5400:cpif_ko",
        "//private/google-modules/radio/samsung/s5400:cpif_page",
        "//private/google-modules/radio/samsung/s5400:shm_ipc",
        "//private/google-modules/sensors/hall_sensor",
    ],
)

# For compatibility
alias(
    name = "zumapro_comet_dist",
    actual = ":comet/dist",
)

alias(
    name = "zumapro_comet_abi_update_symbol_list",
    actual = ":comet/kernel_abi_update_symbol_list",
)

alias(
    name = "kernel",
    actual = ":comet/kernel",
)

alias(
    name = "kernel_abi_update_symbol_list",
    actual = ":comet/kernel_abi_update_symbol_list",
)

alias(
    name = "kernel_compile_commands",
    actual = ":comet/kernel_compile_commands",
)
